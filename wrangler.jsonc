{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudchef",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "app/server.ts",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "cloudchef.build",
      "custom_domain": true,
    },
    {
      "pattern": "www.cloudchef.build",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.6,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "workflows": [
    {
      "binding": "USER_WORKSPACE_RUNTIME_PROVISIONING",
      "name": "cloudchef-user-workspace-runtime-provisioning",
      "class_name": "UserWorkspaceRuntimeProvisioningWorkflow",
    },
  ],
  "ratelimits": [
    {
      "name": "CLOUDFLARE_OAUTH_START_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "CLIENT_TELEMETRY_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "secrets": {
    "required": ["CLOUDFLARE_CREDENTIAL_ENCRYPTION_KEY", "CLOUDFLARE_OAUTH_CLIENT_SECRET"],
  },
  "upload_source_maps": true,
  // Configure production secrets in Cloudflare, not local env files.
  // Deployment credentials are supplied by the CI environment, not as Worker runtime secrets.
  // Deploy tooling injects the environment-specific OAuth client id and commit SHA.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudchef",
      "database_id": "04680db0-07a0-468d-9547-e07f5091756c",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "CLOUDFLARE_OAUTH_SCOPES": "account-settings.read user-details.read workers-scripts.write containers.write d1.write workers-r2.write workers-kv-storage.write ai.read",
  },
}
