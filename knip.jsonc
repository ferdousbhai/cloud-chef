{
  "ignoreExportsUsedInFile": {
    "interface": true,
  },
  "workspaces": {
    ".": {
      "entry": [
        "app/router.tsx",
        // The Worker entrypoint and its config, both read by cf and the Cloudflare Vite plugin.
        "app/server.ts",
        "cloudflare.config.ts",
        // Test entrypoints are explicit because the repository has separate
        // Node/jsdom and workerd Vitest configurations.
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "tests/workerd/**/*.integration.ts",
        "tests/workerd/server-dependencies.stub.ts",
        // Child processes invoked by the canonical generated-artifact command.
        "make-bootstrap-snapshot.js",
        "scripts/build-user-workspace-runtime.mjs",
      ],
      "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}!", "!.cloudchef-runtime-security-*/**"],
      "ignore": [
        "template/**",
        "app/test/cloudflare-workers-shim.ts",
        // Vendored verbatim from the install-anti-slop skill and loaded by Oxlint through
        // `jsPlugins`, which knip does not read. Analysing it would report unused exports
        // against source this repository does not own and must not prune.
        "tools/oxlint/anti-slop/**",
      ],
    },
    "cloudchef-agent": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.{ts,mts}"],
    },
    "user-workspace-runtime": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "template": {
      "entry": ["src/plain-server.ts", "src/server.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs"],
    },
  },

  "ignoreDependencies": [
    // satisfies the Cloudflare Agents decorator transform peer dependency
    "@babel/core",
    "@babel/plugin-proposal-decorators",

    // virtual module provided by the Cloudflare Workers runtime
    "cloudflare",

    // imported by the vendored anti-slop plugin, which knip is told to ignore above
    "@oxlint/plugins",

    // run as `pnpm exec wrangler` by scripts that still need Wrangler (local D1 migrations, ops reads)
    "wrangler",

    // type-only peer of the Agents packages (see pnpm-workspace.yaml peerDependencyRules)
    "@cloudflare/workers-types",
  ],
}
