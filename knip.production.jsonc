{
  "ignoreExportsUsedInFile": {
    "interface": true,
  },
  "workspaces": {
    ".": {
      "entry": [
        "app/router.tsx",
        "app/server.ts",
        "cloudflare.config.ts",
        "make-bootstrap-snapshot.js",
        "scripts/build-user-workspace-runtime.mjs",
        "scripts/verify-template.mjs",
      ],
      "project": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,css}!",
        "!**/*.test.{ts,tsx}",
        "!**/*.spec.{ts,tsx}",
        "!tests/**",
        "!e2e/**",
        // Development tooling, not production source: the vendored anti-slop Oxlint plugin.
        "!tools/**",
        "!.cloudchef-runtime-security-*/**",
      ],
      "ignore": ["template/**", "app/test/cloudflare-workers-shim.ts"],
    },
    // A library the control plane and runtime import: an export only its tests read is flagged.
    "cloudchef-agent": {
      "project": ["**/*.{ts,mts}!", "!**/*.test.ts", "!vitest.config.mts"],
      "includeEntryExports": true,
    },
    "user-workspace-runtime": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts!", "!src/**/*.test.ts"],
    },
  },
  // As in knip.jsonc: a system tool, not an npm package.
  "ignoreBinaries": ["shellcheck"],
  // `wrangler` and `@cloudflare/workers-types` are explained in knip.jsonc.
  "ignoreDependencies": [
    "@babel/core",
    "@babel/plugin-proposal-decorators",
    "cloudflare",
    "wrangler",
    "@cloudflare/workers-types",
  ],
}
