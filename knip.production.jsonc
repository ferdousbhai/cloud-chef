{
  "ignoreExportsUsedInFile": {
    "interface": true,
  },
  "workspaces": {
    ".": {
      "entry": ["app/router.tsx", "make-bootstrap-snapshot.js", "scripts/build-user-workspace-runtime.mjs"],
      "project": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}!",
        "!**/*.test.{ts,tsx}",
        "!**/*.spec.{ts,tsx}",
        "!tests/**",
        "!e2e/**",
        // Development tooling, not production source: the vendored anti-slop Oxlint plugin.
        "!tools/**",
        "!.cloudchef-runtime-security-*/**",
      ],
      "ignore": ["template/**", "app/test/cloudflare-workers-shim.ts"],
    },
    "user-workspace-runtime": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts!", "!src/**/*.test.ts"],
    },
  },
  // `@oxlint/plugins` is imported only by the vendored plugin under tools/, which this
  // production view excludes by design.
  "ignoreDependencies": ["@babel/core", "@babel/plugin-proposal-decorators", "cloudflare", "@oxlint/plugins"],
}
