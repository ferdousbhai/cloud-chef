#!/usr/bin/env bash
# cloudchef: work on CloudChef projects from your own computer, the way gh works with GitHub.
# Needs only bash (3.2 or later), curl and git. Install: curl -fsSL https://cloudchef.build/install.sh | bash
set -o pipefail

CLOUDCHEF_VERSION="0.1.0"
HOST="${CLOUDCHEF_HOST:-https://cloudchef.build}"
HOST="${HOST%/}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cloudchef"
TOKEN_FILE="$CONFIG_DIR/token"
CONFIG_FILE="$CONFIG_DIR/config"
DEFAULT_CLONE_DIR="~/cloudflare"
TAB="$(printf '\t')"
NL='
'

# ---------- output ----------

die() {
  printf 'cloudchef: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*" >&2
}

# ---------- small helpers ----------

# The host's name without the scheme, as people say it (cloudchef.build).
host_display() {
  local h="${HOST#*://}"
  printf '%s' "${h%%/*}"
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$TAB/\\t}"
  s="${s//$NL/\\n}"
  printf '%s' "$s"
}

# json_field KEY JSON: the first scalar value of KEY anywhere in JSON (strings unescaped simply; null is empty).
# Only for the few flat fields this tool reads; it is not a JSON parser.
json_field() {
  local key="$1" raw bs q
  bs="$(printf '\001')"
  q="$(printf '\002')"
  raw="$(printf '%s' "$2" | tr '\n\r' '  ' |
    sed -e "s/\\\\\\\\/$bs/g" -e "s/\\\\\"/$q/g" |
    grep -oE "\"$key\"[[:space:]]*:[[:space:]]*(\"[^\"]*\"|[^],}\"[:space:]]+)" | head -n 1)"
  [ -n "$raw" ] || return 0
  raw="${raw#*:}"
  raw="$(printf '%s' "$raw" | sed -e 's/^[[:space:]]*//')"
  case "$raw" in
    \"*)
      raw="${raw#\"}"
      raw="${raw%\"}"
      ;;
    null) raw="" ;;
  esac
  printf '%s' "$raw" | sed -e 's#\\/#/#g' -e 's/\\n/ /g' -e 's/\\t/ /g' -e "s/$q/\"/g" -e "s/$bs/\\\\/g"
}

urlencode() {
  local s="$1" out="" c i
  local LC_ALL=C
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out="$out$c" ;;
      *) out="$out$(printf '%%%02X' "'$c")" ;;
    esac
  done
  printf '%s' "$out"
}

# A folder-safe form of a name: lowercase, anything outside [a-z0-9._-] becomes '-', repeats collapse, ends trimmed.
folder_safe() {
  local s
  s="$(printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' |
    LC_ALL=C sed -e 's/[^a-z0-9._-]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//')"
  case "$s" in
    "" | . | ..) s="project" ;;
  esac
  printf '%s' "$s"
}

expand_home() {
  case "$1" in
    "~") printf '%s' "$HOME" ;;
    "~/"*) printf '%s/%s' "$HOME" "${1#"~/"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

open_url() {
  local url="$1" opener="${CLOUDCHEF_BROWSER:-}"
  if [ -z "$opener" ]; then
    if command -v open >/dev/null 2>&1 && [ "$(uname -s)" = "Darwin" ]; then
      opener=open
    elif command -v xdg-open >/dev/null 2>&1; then
      opener=xdg-open
    else
      return 0
    fi
  fi
  ($opener "$url" >/dev/null 2>&1 &) 2>/dev/null
  return 0
}

print_table() {
  # stdin: tab-separated rows, the first being the header.
  if command -v column >/dev/null 2>&1; then
    column -t -s "$TAB"
  else
    awk -F '\t' '{ rows[NR] = $0; for (i = 1; i <= NF; i++) if (length($i) > w[i]) w[i] = length($i); if (NF > n) n = NF }
      END { for (r = 1; r <= NR; r++) { c = split(rows[r], f, "\t"); line = "";
        for (i = 1; i <= c; i++) line = line (i < c ? sprintf("%-" w[i] "s  ", f[i]) : f[i]); print line } }'
  fi
}

# ---------- config ----------

config_get() {
  [ -f "$CONFIG_FILE" ] || return 0
  grep -E "^$1=" "$CONFIG_FILE" | tail -n 1 | sed -e "s/^$1=//"
}

config_set() {
  local tmp
  (umask 077 && mkdir -p "$CONFIG_DIR") || die "Could not create $CONFIG_DIR."
  tmp="$CONFIG_FILE.tmp.$$"
  { [ -f "$CONFIG_FILE" ] && grep -vE "^$1=" "$CONFIG_FILE"; printf '%s=%s\n' "$1" "$2"; } >"$tmp" &&
    mv "$tmp" "$CONFIG_FILE" || die "Could not write $CONFIG_FILE."
}

clone_base() {
  local base="${CLOUDCHEF_CLONE_DIR:-}"
  [ -n "$base" ] || base="$(config_get clone-dir)"
  [ -n "$base" ] || base="$DEFAULT_CLONE_DIR"
  expand_home "$base"
}

# ---------- token ----------

read_token() {
  if [ -n "${CLOUDCHEF_TOKEN:-}" ]; then
    printf '%s' "$CLOUDCHEF_TOKEN"
  elif [ -f "$TOKEN_FILE" ]; then
    tr -d ' \n\r' <"$TOKEN_FILE"
  fi
}

require_token() {
  TOKEN="$(read_token)"
  [ -n "$TOKEN" ] || die "Not logged in. Run: cloudchef auth login"
}

# ---------- HTTP ----------

# http METHOD PATH [curl args...]: sets HTTP_STATUS and HTTP_BODY. Sends the token when TOKEN is set; the token goes to
# curl on stdin (-K -), never on its command line.
http() {
  local method="$1" path="$2" out
  shift 2
  out="$( ([ -z "${TOKEN:-}" ] || printf 'header = "Authorization: Bearer %s"\n' "$TOKEN") |
    curl -sS -K - -X "$method" -H "User-Agent: cloudchef-cli/$CLOUDCHEF_VERSION" -w "${NL}%{http_code}" "$@" "$HOST$path")" ||
    die "Could not reach $HOST."
  HTTP_STATUS="${out##*"$NL"}"
  HTTP_BODY="${out%"$NL"*}"
}

http_ok() {
  case "$HTTP_STATUS" in
    2??) return 0 ;;
  esac
  local message
  message="$(json_field error "$HTTP_BODY")"
  if [ "$HTTP_STATUS" = "401" ]; then
    die "${message:-Not logged in.} Run: cloudchef auth login"
  fi
  [ -n "$message" ] || message="$(printf '%s' "$HTTP_BODY" | head -c 300)"
  die "${message:-The server answered HTTP $HTTP_STATUS.} (HTTP $HTTP_STATUS)"
}

# api_get PATH: an authenticated GET whose body lands in HTTP_BODY, failing on any non-2xx answer.
api_get() {
  require_token
  http GET "$1"
  http_ok
}

api_post_json() {
  require_token
  http POST "$1" -H "Content-Type: application/json" --data-binary "$2"
  http_ok
}

# ---------- projects ----------

projects_tsv() {
  api_get "/api/command-line/projects?format=tsv"
  PROJECTS_TSV="$HTTP_BODY"
}

# The project id of the current directory's CloudChef git remote, if it has one.
remote_project_id() {
  local url id
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  git remote -v 2>/dev/null | while read -r _ url _; do
    case "$url" in
      "$HOST/git/"*) ;;
      *) continue ;;
    esac
    id="${url#"$HOST/git/"}"
    id="${id%.git}"
    id="${id%/}"
    printf '%s\n' "$id"
    break
  done
}

# resolve_project [PROJECT]: sets P_NAME P_ACCOUNT P_ROLE P_STATE P_SITE P_ID. PROJECT is a name, ACCOUNT/NAME, or an
# id; without one, the current directory's CloudChef git remote.
resolve_project() {
  local want="$1" from_remote="" want_account="" want_name="" matches="" count=0 choices=""
  local name account role state site id
  if [ -z "$want" ]; then
    want="$(remote_project_id)"
    [ -n "$want" ] || die "Name a project, or run this inside a clone of one. See: cloudchef repo list"
    from_remote=1
  fi
  projects_tsv
  case "$want" in
    */*)
      want_account="${want%%/*}"
      want_name="${want#*/}"
      ;;
  esac
  # An exact id wins.
  while IFS="$TAB" read -r name account role state site id; do
    [ -n "$id" ] || continue
    if [ "$id" = "$want" ]; then
      P_NAME="$name" P_ACCOUNT="$account" P_ROLE="$role" P_STATE="$state" P_SITE="$site" P_ID="$id"
      return 0
    fi
  done <<EOF
$PROJECTS_TSV
EOF
  [ -z "$from_remote" ] || die "This folder's CloudChef project ($want) isn't one you can use any more."
  while IFS="$TAB" read -r name account role state site id; do
    [ -n "$id" ] && [ "$id" != "id" ] || continue
    if [ -n "$want_account" ]; then
      [ "$account" = "$want_account" ] && [ "$name" = "$want_name" ] || continue
    else
      [ "$name" = "$want" ] || continue
    fi
    count=$((count + 1))
    matches="$name$TAB$account$TAB$role$TAB$state$TAB$site$TAB$id"
    choices="$choices  $account/$name$NL"
  done <<EOF
$PROJECTS_TSV
EOF
  if [ "$count" -eq 0 ]; then
    die "No project named \"$want\". See: cloudchef repo list"
  elif [ "$count" -gt 1 ]; then
    die "Several accounts have a project named \"$want\". Name one as ACCOUNT/NAME:$NL${choices%"$NL"}"
  fi
  IFS="$TAB" read -r P_NAME P_ACCOUNT P_ROLE P_STATE P_SITE P_ID <<EOF
$matches
EOF
}

git_url() {
  printf '%s/git/%s.git' "$HOST" "$1"
}

dash_to_empty() {
  [ "$1" = "-" ] || printf '%s' "$1"
}

# ---------- runs ----------

runs_tsv() {
  api_get "/api/command-line/runs?project=$(urlencode "$1")&format=tsv"
  RUNS_TSV="$HTTP_BODY"
}

# find_run RUN_ID|"" : sets R_STATE R_KIND R_BRANCH R_COMMIT R_UPDATED R_ID from RUNS_TSV (the newest without an id).
find_run() {
  local want="$1" state kind branch commit updated id
  R_ID=""
  while IFS="$TAB" read -r state kind branch commit updated id; do
    [ -n "$id" ] && [ "$id" != "id" ] || continue
    if [ -z "$want" ] || [ "$id" = "$want" ]; then
      R_STATE="$state" R_KIND="$kind" R_BRANCH="$branch" R_COMMIT="$commit" R_UPDATED="$updated" R_ID="$id"
      return 0
    fi
  done <<EOF
$RUNS_TSV
EOF
  return 1
}

# find_run_for_commit COMMIT: the newest run of that commit.
find_run_for_commit() {
  local want="$1" state kind branch commit updated id
  while IFS="$TAB" read -r state kind branch commit updated id; do
    [ -n "$id" ] && [ "$id" != "id" ] || continue
    if [ "${commit:0:7}" = "${want:0:7}" ]; then
      R_STATE="$state" R_KIND="$kind" R_BRANCH="$branch" R_COMMIT="$commit" R_UPDATED="$updated" R_ID="$id"
      return 0
    fi
  done <<EOF
$RUNS_TSV
EOF
  return 1
}

is_finished() {
  case "$1" in
    succeeded | failed | not_deployable) return 0 ;;
  esac
  return 1
}

# ---------- help ----------

usage() {
  case "$1" in
    "")
      cat <<EOF
Work on CloudChef projects from your own computer.

Usage: cloudchef <command> <subcommand> [flags]

Auth
  auth login           Sign in from the browser and set up git
  auth status          Show who you're signed in as
  auth logout          Remove the token from this computer
  auth token           Print the token
  auth setup-git       Let git sign in to CloudChef through cloudchef

Projects
  repo list            List the projects you can use
  repo view [PROJECT]  Show a project
  repo clone PROJECT   Clone a project
  repo create NAME     Upload a folder as a new project

Publishes
  run list [PROJECT]   List a project's publishes and previews
  run view [RUN_ID]    Show a publish, or its log with --log
  run watch [RUN_ID]   Wait for a publish to finish
  run rerun [RUN_ID]   Publish the same commit again

More
  browse [PROJECT]     Open a project's site
  api PATH             Make an authenticated request to the CloudChef API
  config               Read and change settings (clone-dir)
  skill install        Install the cloudchef skill for Claude Code
  help [COMMAND]       Show help for a command
  --version            Show the version

PROJECT is a project name, ACCOUNT/NAME, or a project id. Inside a clone it defaults to that project.
Environment: CLOUDCHEF_HOST (default https://cloudchef.build), CLOUDCHEF_TOKEN, CLOUDCHEF_CLONE_DIR.
EOF
      ;;
    auth)
      cat <<EOF
Usage: cloudchef auth <login|status|logout|token|setup-git|git-credential>

  login           Sign in from the browser; saves a token and sets up git
  status          Show who you're signed in as
  logout          Remove the token from this computer
  token           Print the token (never paste it anywhere public)
  setup-git       Let git sign in to $(host_display) through cloudchef
  git-credential  The git credential helper (git runs it; you don't need to)
EOF
      ;;
    "auth login") echo "Usage: cloudchef auth login${NL}${NL}Shows a code, opens $HOST in the browser to approve this computer, saves the token to $TOKEN_FILE, and sets up git." ;;
    "auth status") echo "Usage: cloudchef auth status${NL}${NL}Shows who the token belongs to." ;;
    "auth logout") echo "Usage: cloudchef auth logout${NL}${NL}Deletes $TOKEN_FILE. Revoke the token in CloudChef too: Settings → Command line." ;;
    "auth token") echo "Usage: cloudchef auth token${NL}${NL}Prints the token. Keep it secret." ;;
    "auth setup-git") echo "Usage: cloudchef auth setup-git${NL}${NL}Sets cloudchef as git's credential helper for $HOST in your global git config." ;;
    "auth git-credential") echo "Usage: cloudchef auth git-credential <get|store|erase>${NL}${NL}The git credential helper protocol. Answers only for $HOST." ;;
    repo)
      cat <<EOF
Usage: cloudchef repo <list|view|clone|create>

  list [--json]                                   List the projects you can use
  view [PROJECT] [--json] [--web]                 Show a project
  clone PROJECT [DIR] [-- GIT_FLAGS]              Clone a project
  create NAME [--account ACCOUNT] [--source DIR]  Upload a folder as a new project
EOF
      ;;
    "repo list") echo "Usage: cloudchef repo list [--json]${NL}${NL}Lists the projects you can view or edit, in every account you use." ;;
    "repo view") echo "Usage: cloudchef repo view [PROJECT] [--json] [--web]${NL}${NL}Shows a project's account, your role, its git address, site and last publish.${NL}--web opens the projects page." ;;
    "repo clone")
      cat <<EOF
Usage: cloudchef repo clone PROJECT [DIR] [-- GIT_FLAGS]

Clones a project. Without DIR it goes to <clone-dir>/<account>/<project>, where clone-dir is
\$CLOUDCHEF_CLONE_DIR, else \`cloudchef config get clone-dir\`, else ~/cloudflare.
Now: $(clone_base)
EOF
      ;;
    "repo create")
      cat <<EOF
Usage: cloudchef repo create NAME [--account ACCOUNT] [--source DIR]

Uploads the committed files of DIR (default: the current folder) as a new project, which then publishes.
Outside a git repository, every file not ignored by .gitignore is uploaded. The project starts with a
fresh history; in a git repository a "cloudchef" remote is added for it.
--account names the account to create it in (default: your own).
EOF
      ;;
    run)
      cat <<EOF
Usage: cloudchef run <list|view|watch|rerun>

  list [PROJECT] [--json]                       A project's publishes and previews, newest first
  view [RUN_ID] [--project PROJECT] [--log]     Show a publish, or print its log
  watch [RUN_ID] [--project PROJECT] [-i SECS]  Wait for a publish to finish; exits 1 unless it succeeded
  rerun [RUN_ID] [--project PROJECT]            Publish the same commit again
EOF
      ;;
    "run list") echo "Usage: cloudchef run list [PROJECT] [--json]" ;;
    "run view") echo "Usage: cloudchef run view [RUN_ID] [--project PROJECT] [--log]${NL}${NL}Without RUN_ID, the newest publish." ;;
    "run watch") echo "Usage: cloudchef run watch [RUN_ID] [--project PROJECT] [--interval SECONDS]${NL}${NL}Waits for a publish to finish (inside a clone: the publish of its current commit) and${NL}exits 0 if it succeeded, 1 if not." ;;
    "run rerun") echo "Usage: cloudchef run rerun [RUN_ID] [--project PROJECT]${NL}${NL}Without RUN_ID, the newest publish." ;;
    browse) echo "Usage: cloudchef browse [PROJECT] [--no-browser]${NL}${NL}Opens the project's site (or the projects page when it has none). --no-browser prints the address." ;;
    api) echo "Usage: cloudchef api PATH [-X METHOD] [-d DATA]${NL}${NL}Requests $HOST/PATH with your token and prints the answer. -d sends JSON and defaults the method to POST." ;;
    config)
      cat <<EOF
