Clones a project. Without DIR it goes to <clone-dir>/<owner>/<name>, where clone-dir is
\$CLOUDCHEF_CLONE_DIR, else \`cloudchef config get clone-dir\`, else ~/cloudflare.
Now: $(clone_base)

Example: cloudchef repo clone ferdous/alberta-plan-glossary
  clones into $(clone_base)/ferdous/alberta-plan-glossary
EOF
      ;;
    "repo create")
      cat <<EOF
Usage: cloudchef repo create NAME [--account ACCOUNT] [--source DIR] [--push] [--remote NAME]

Makes a new project from DIR (default: the current folder).

When DIR is a git repository with commits, the project keeps its history: it is made empty, DIR gets
the git remote "cloudchef" for it, and --push pushes HEAD to its main, which publishes it. Without
--push, push when you're ready: git push -u cloudchef HEAD:main

Otherwise every file of DIR that .gitignore doesn't exclude is uploaded, and the project publishes.

  --account ACCOUNT  The account to make it in (default: your own)
  --source DIR       The folder to make it from
  --push             Push the repository's history to main
  --remote NAME      Name the git remote NAME instead of "cloudchef"

Example: cloudchef repo create my-site --push
EOF
      ;;
    run)
      cat <<EOF
Usage: cloudchef run <list|view|watch|rerun>

  list [PROJECT] [--json]                       A project's publishes and previews, newest first
  view [RUN_ID] [--project PROJECT] [--log]     Show a publish, or print its log
  watch [RUN_ID] [--project PROJECT] [-i SECS]  Wait for a publish to finish; exits 1 unless it succeeded
  rerun [RUN_ID] [--project PROJECT]            Publish the same commit again
EOF
      ;;
    "run list") echo "Usage: cloudchef run list [PROJECT] [--json]" ;;
    "run view") echo "Usage: cloudchef run view [RUN_ID] [--project PROJECT] [--log]${NL}${NL}Without RUN_ID, the newest publish." ;;
    "run watch") echo "Usage: cloudchef run watch [RUN_ID] [--project PROJECT] [--interval SECONDS]${NL}${NL}Waits for a publish to finish (inside a clone: the publish of its current commit) and${NL}exits 0 if it succeeded, 1 if not." ;;
    "run rerun") echo "Usage: cloudchef run rerun [RUN_ID] [--project PROJECT]${NL}${NL}Without RUN_ID, the newest publish." ;;
    browse) echo "Usage: cloudchef browse [PROJECT] [--no-browser]${NL}${NL}Opens the project's site (or the projects page when it has none). --no-browser prints the address." ;;
    api) echo "Usage: cloudchef api PATH [-X METHOD] [-d DATA]${NL}${NL}Requests $HOST/PATH with your token and prints the answer. -d sends JSON and defaults the method to POST." ;;
    config)
      cat <<EOF
Usage: cloudchef config <get|set|list>

  get KEY        Print a setting
  set KEY VALUE  Change a setting
  list           Print every setting

Settings (kept in $CONFIG_FILE):
  clone-dir  Where repo clone puts projects (default ~/cloudflare); CLOUDCHEF_CLONE_DIR overrides it
EOF
      ;;
    skill | "skill install")
      cat <<EOF
Usage: cloudchef skill install [--dir DIR]

Writes the cloudchef agent skill (an Agent Skills folder, cloudchef/SKILL.md) to ~/.agents/skills, which
Codex, OpenCode and other agents read. When ~/.claude exists, ~/.claude/skills/cloudchef becomes a link to
it, for Claude Code. --dir DIR writes only DIR/cloudchef/SKILL.md.
EOF
      ;;
    *) return 1 ;;
  esac
}

wants_help() {
  local a
  for a in "$@"; do
    case "$a" in
      -h | --help) return 0 ;;
      --) return 1 ;;
    esac
  done
  return 1
}

need_value() {
  [ "$2" -ge 2 ] || die "$1 needs a value."
}

# ---------- auth ----------

cmd_auth_login() {
  local label body device user_code verify interval expires token email
  label="$(hostname 2>/dev/null || uname -n) (cloudchef CLI)"
  TOKEN=""
  http POST /api/command-line/login -H "Content-Type: application/json" --data-binary "{\"label\":\"$(json_escape "$label")\"}"
  http_ok
  body="$HTTP_BODY"
  device="$(json_field deviceCode "$body")"
  user_code="$(json_field userCode "$body")"
  verify="$(json_field verificationUriComplete "$body")"
  [ -n "$verify" ] || verify="$(json_field verificationUri "$body")"
  interval="$(json_field interval "$body")"
  expires="$(json_field expiresIn "$body")"
  [ -n "$device" ] || die "The server didn't start a sign-in."
  case "$interval" in '' | *[!0-9]*) interval=5 ;; esac
  case "$expires" in '' | *[!0-9]*) expires=900 ;; esac

  printf 'Your one-time code: %s\n' "$user_code"
  printf 'Open %s\n' "$verify"
  printf 'and approve this computer. Waiting...\n'
  open_url "$verify"

  local deadline=$((SECONDS + expires))
  while :; do
    sleep "$interval"
    http POST /api/command-line/login/poll -H "Content-Type: application/json" \
      --data-binary "{\"deviceCode\":\"$(json_escape "$device")\"}"
    case "$HTTP_STATUS" in
      200) break ;;
      428)
        [ "$SECONDS" -lt "$deadline" ] || die "The code expired. Run cloudchef auth login again."
        ;;
      *)
        local message
        message="$(json_field error "$HTTP_BODY")"
        die "${message:-Sign-in failed (HTTP $HTTP_STATUS).}"
        ;;
    esac
  done
  token="$(json_field token "$HTTP_BODY")"
  email="$(json_field email "$HTTP_BODY")"
  [ -n "$token" ] || die "The server didn't send a token."
  (
    umask 077
    mkdir -p "$CONFIG_DIR" && printf '%s\n' "$token" >"$TOKEN_FILE" && chmod 600 "$TOKEN_FILE"
  ) || die "Could not save the token to $TOKEN_FILE."
  cmd_auth_setup_git >/dev/null
  printf 'Logged in as %s\n' "${email:-your CloudChef account}"
}

cmd_auth_status() {
  local token source email
  token="$(read_token)"
  if [ -z "$token" ]; then
    printf 'Not logged in to %s. Run: cloudchef auth login\n' "$(host_display)"
    return 1
  fi
  if [ -n "${CLOUDCHEF_TOKEN:-}" ]; then source="CLOUDCHEF_TOKEN"; else source="$TOKEN_FILE"; fi
  TOKEN="$token"
  http GET /api/command-line/user
  if [ "$HTTP_STATUS" = "401" ]; then
    printf 'Not logged in to %s: the token in %s was revoked or has expired. Run: cloudchef auth login\n' "$(host_display)" "$source"
    return 1
  fi
  http_ok
  email="$(json_field email "$HTTP_BODY")"
  printf 'Logged in to %s as %s\n' "$(host_display)" "$email"
  printf 'Token: %s\n' "$source"
}

cmd_auth_logout() {
  if [ -f "$TOKEN_FILE" ]; then
    rm -f "$TOKEN_FILE" || die "Could not remove $TOKEN_FILE."
    printf 'Logged out: removed %s.\n' "$TOKEN_FILE"
  else
    printf 'No token saved on this computer.\n'
  fi
  [ -z "${CLOUDCHEF_TOKEN:-}" ] || printf 'CLOUDCHEF_TOKEN is still set in this shell.\n'
  printf 'Revoke the token in CloudChef too: Settings → Command line.\n'
}

cmd_auth_token() {
  require_token
  printf '%s\n' "$TOKEN"
}

# The command git runs: plain `cloudchef` when that is this script on PATH, else this script's own path.
self_command() {
  local self dir
  dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
  self="$dir/$(basename "$0")"
  if [ "$(command -v cloudchef 2>/dev/null)" = "$self" ]; then
    printf 'cloudchef'
  else
    printf "'%s'" "$self"
  fi
}

cmd_auth_setup_git() {
  local key="credential.$HOST"
  # shellcheck disable=SC2015 # either step failing is the same failure
  git config --global "$key.helper" "" &&
    git config --global --add "$key.helper" "!$(self_command) auth git-credential" &&
    git config --global "$key.username" cloudchef ||
    die "Could not update your global git config."
  printf 'git now signs in to %s through cloudchef.\n' "$(host_display)"
}

cmd_auth_git_credential() {
  local op="$1" line protocol="" host="" token want_protocol want_host
  while IFS= read -r line; do
    [ -n "$line" ] || break
    case "$line" in
      protocol=*) protocol="${line#protocol=}" ;;
      host=*) host="${line#host=}" ;;
    esac
  done
  [ "$op" = "get" ] || return 0
  want_protocol="${HOST%%://*}"
  want_host="$(host_display)"
  [ "$protocol" = "$want_protocol" ] && [ "$host" = "$want_host" ] || return 0
  token="$(read_token)"
  [ -n "$token" ] || return 0
  printf 'protocol=%s\nhost=%s\nusername=cloudchef\npassword=%s\n' "$protocol" "$host" "$token"
}

cmd_auth() {
  local sub="$1"
  [ $# -gt 0 ] && shift
  if [ -z "$sub" ] || [ "$sub" = "-h" ] || [ "$sub" = "--help" ]; then usage auth; return 0; fi
  if wants_help "$@"; then usage "auth $sub" || usage auth; return 0; fi
  case "$sub" in
    login) cmd_auth_login ;;
    status) cmd_auth_status ;;
    logout) cmd_auth_logout ;;
    token) cmd_auth_token ;;
    setup-git) cmd_auth_setup_git ;;
    git-credential) cmd_auth_git_credential "$@" ;;
    *) die "Unknown command: auth $sub. See: cloudchef help auth" ;;
  esac
}

# ---------- repo ----------

cmd_repo_list() {
  local json="" public=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --public) public=1 ;;
      *) die "Unknown argument: $1. See: cloudchef repo list --help" ;;
    esac
    shift
  done
  if [ -n "$public" ]; then
    if [ -n "$json" ]; then
      api_get /api/explore
      printf '%s\n' "$HTTP_BODY"
      return 0
    fi
    api_get "/api/explore?format=tsv"
    if ! printf '%s\n' "$HTTP_BODY" | grep -q "$TAB"; then
      printf 'No public projects yet.\n'
      return 0
    fi
    {
      printf 'NAME\tOWNER\tSITE\n'
      printf '%s\n' "$HTTP_BODY" |
        awk -F '\t' -v OFS='\t' 'NF >= 5 && $5 != "id" { print (($1 == "" || $1 == "-") ? $2 : $1), $3, ($4 == "" ? "-" : $4) }'
    } | print_table
    return 0
  fi
  if [ -n "$json" ]; then
    api_get /api/command-line/projects
    printf '%s\n' "$HTTP_BODY"
    return 0
  fi
  projects_tsv
  if ! printf '%s\n' "$PROJECTS_TSV" | grep -q "$TAB"; then
    printf 'No projects yet.\n'
    return 0
  fi
  {
    printf 'NAME\tACCOUNT\tROLE\tVISIBILITY\tPUBLISH\tSITE\n'
    printf '%s\n' "$PROJECTS_TSV" |
      awk -F '\t' -v OFS='\t' 'NF >= 6 && $6 != "id" {
        print (($7 == "" || $7 == "-") ? $1 : $7), $2, $3, ($8 == "" ? "-" : $8), $4, $5 }'
  } | print_table
}

project_json() {
  local site state
  site="$(dash_to_empty "$P_SITE")"
  state="$(dash_to_empty "$P_STATE")"
  printf '{"id":"%s","name":"%s","fullName":%s,"account":"%s","role":%s,"visibility":%s,"gitUrl":"%s","siteUrl":%s,"lastPublishState":%s}\n' \
    "$(json_escape "$P_ID")" "$(json_escape "$P_NAME")" \
    "$([ "$P_FULL" != "-" ] && printf '"%s"' "$(json_escape "$P_FULL")" || printf null)" \
    "$(json_escape "$P_ACCOUNT")" \
    "$([ "$P_ROLE" != "-" ] && printf '"%s"' "$(json_escape "$P_ROLE")" || printf null)" \
    "$([ "$P_VIS" != "-" ] && printf '"%s"' "$(json_escape "$P_VIS")" || printf null)" \
    "$(json_escape "$(git_url)")" \
    "$([ -n "$site" ] && printf '"%s"' "$(json_escape "$site")" || printf null)" \
    "$([ -n "$state" ] && printf '"%s"' "$(json_escape "$state")" || printf null)"
}

cmd_repo_view() {
  local project="" json="" web=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --web | -w) web=1 ;;
      -*) die "Unknown flag: $1. See: cloudchef repo view --help" ;;
      *) [ -z "$project" ] || die "Too many arguments."; project="$1" ;;
    esac
    shift
  done
  if [ -n "$web" ]; then
    printf 'Opening %s/\n' "$HOST"
    open_url "$HOST/"
    return 0
  fi
  resolve_project "$project"
  if [ -n "$json" ]; then
    project_json
    return 0
  fi
  printf 'name:          %s\n' "$P_REF"
  [ "$P_FULL" != "-" ] && [ "$P_NAME" = "${P_FULL#*/}" ] || printf 'title:         %s\n' "$P_NAME"
  if [ "$P_ROLE" = "-" ]; then
    printf 'owner:         %s\n' "$P_ACCOUNT"
    printf 'role:          none (a public project: you can clone and copy it)\n'
  else
    printf 'account:       %s\n' "$P_ACCOUNT"
    printf 'role:          %s\n' "$P_ROLE"
  fi
  printf 'visibility:    %s\n' "$P_VIS"
  printf 'git:           %s\n' "$(git_url)"
  printf 'site:          %s\n' "$P_SITE"
  printf 'last publish:  %s\n' "$P_STATE"
  printf 'id:            %s\n' "$P_ID"
}

cmd_repo_clone() {
  local project="" dir=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; break ;;
      -*) die "Unknown flag: $1. Pass git clone flags after --." ;;
      *)
        if [ -z "$project" ]; then project="$1"
        elif [ -z "$dir" ]; then dir="$1"
        else die "Too many arguments."
        fi
        ;;
    esac
    shift
  done
  [ -n "$project" ] || die "Name the project to clone. See: cloudchef repo list"
  resolve_project "$project"
  if [ -n "$dir" ]; then
    dir="$(expand_home "$dir")"
  else
    dir="$(default_clone_path)"
  fi
  mkdir -p "$(dirname "$dir")" || die "Could not create $(dirname "$dir")."
  git clone "$@" "$(git_url)" "$dir" || exit 1
  printf 'Cloned %s into %s\n' "$P_REF" "$dir"
}

# read_created_project ACCOUNT: from a new project's answer (201 {"project":{...}}), sets P_ID P_FULL P_NAME P_ACCOUNT
# P_REF and CREATED_GIT_URL.
read_created_project() {
  local id full
  id="$(json_field id "$HTTP_BODY")"
  full="$(json_field fullName "$HTTP_BODY")"
  [ -n "$id" ] || die "The server didn't say which project it made."
  P_ID="$id" P_FULL="${full:--}" P_NAME="$(json_field name "$HTTP_BODY")" P_ACCOUNT="$1"
  if [ -n "$full" ]; then P_REF="$full"; else P_REF="$id"; fi
  CREATED_GIT_URL="$(json_field gitUrl "$HTTP_BODY")"
  [ -n "$CREATED_GIT_URL" ] || CREATED_GIT_URL="$(git_url)"
}

# A git repository with commits becomes an empty project that its history is pushed to (like
# gh repo create --source . --push); any other folder is uploaded as a ZIP of its files, which then publishes.
cmd_repo_create() {
  local name="" account="" source="" source_given="" push="" remote="cloudchef" remote_given=""
  local is_repo="" has_history="" tmp zip query top abs existing push_command track="" where=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --account) need_value "$1" $#; account="$2"; shift ;;
      --account=*) account="${1#--account=}" ;;
      --source) need_value "$1" $#; source="$2"; source_given=1; shift ;;
      --source=*) source="${1#--source=}"; source_given=1 ;;
      --remote | -r) need_value "$1" $#; remote="$2"; remote_given=1; shift ;;
      --remote=*) remote="${1#--remote=}"; remote_given=1 ;;
      --push) push=1 ;;
      -*) die "Unknown flag: $1. See: cloudchef repo create --help" ;;
      *) [ -z "$name" ] || die "Too many arguments."; name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "Name the new project: cloudchef repo create NAME"
  [ -n "$source" ] || source="."
  source="$(expand_home "$source")"
  [ -d "$source" ] || die "No folder $source."
  abs="$(cd "$source" && pwd -P)" || die "Can't open $source."
  require_token

  top="$(git -C "$abs" rev-parse --show-toplevel 2>/dev/null)" && top="$(cd "$top" && pwd -P)"
  [ "$top" = "$abs" ] && is_repo=1
  if [ -n "$is_repo" ]; then
    git -C "$abs" rev-parse --verify -q HEAD >/dev/null && has_history=1
    git check-ref-format "refs/remotes/$remote/main" || die "\"$remote\" can't be the name of a git remote."
    # Checked before the project is made, so a clash never leaves an unused project behind.
    if existing="$(git -C "$abs" remote get-url "$remote" 2>/dev/null)"; then
      die "This repository already has a git remote \"$remote\" ($existing). Choose another name with --remote NAME."
    fi
  elif [ -n "$remote_given" ]; then
    die "--remote needs a git repository, and $abs isn't one."
  fi
  query="name=$(urlencode "$name")"
  [ -z "$account" ] || query="$query&account=$(urlencode "$account")"
  [ "$abs" = "$(pwd -P)" ] || where=" (in $abs)"

  if [ -n "$has_history" ]; then
    [ -n "$source_given" ] || note "Making the project from this repository ($abs). Use --source DIR for another."
    if [ -n "$(git -C "$abs" status --porcelain 2>/dev/null)" ]; then
      note "Only commits are pushed; this repository has changes that aren't committed."
    fi
    http POST "/api/command-line/projects/create?$query&empty=1"
    http_ok
    read_created_project "$account"
    printf 'Created %s.\n' "$P_REF"
    printf 'git: %s\n' "$CREATED_GIT_URL"
    git -C "$abs" remote add "$remote" "$CREATED_GIT_URL" || die "Could not add the git remote \"$remote\"."
    printf 'Added the git remote "%s".\n' "$remote"
    # On a branch, that branch then follows the project's main.
    git -C "$abs" symbolic-ref -q HEAD >/dev/null && track=1
    push_command="git push ${track:+-u }$remote HEAD:main"
    if [ -z "$push" ]; then
      printf 'It is empty until you push your history; pushing to main publishes it:\n  %s%s\n' "$push_command" "$where"
      printf 'Then follow the publish: cloudchef run watch --project %s\n' "$P_REF"
      return 0
    fi
    note "Pushing to main..."
    git -C "$abs" push ${track:+-u} "$remote" HEAD:main ||
      die "The push didn't go through. The project is there, empty; push again with: $push_command$where"
    printf 'Pushed your history to main. It is publishing now.\n'
    printf 'Follow the publish: cloudchef run watch --project %s\n' "$P_REF"
    return 0
  fi

  [ -z "$push" ] || note "Nothing to push: $abs has no commits, so its files are uploaded instead, and they publish by themselves."
  [ -n "$source_given" ] || note "Uploading the current folder ($abs). Use --source DIR to upload another."
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/cloudchef.XXXXXX")" || die "Could not make a temporary folder."
  trap 'rm -rf "$tmp"' EXIT
  zip="$tmp/upload.zip"
  # Every file .gitignore doesn't exclude, gathered through a throwaway index so the folder itself is untouched.
  (
    export GIT_DIR="$tmp/index.git"
    git init -q &&
      git --work-tree="$abs" add -A &&
      git -c user.name=cloudchef -c user.email=cli@cloudchef.build -c commit.gpgsign=false \
        --work-tree="$abs" commit -q --no-verify -m "Upload" >/dev/null &&
      git archive --format=zip -o "$zip" HEAD
  ) || die "Could not make the upload (is $abs empty?)."

  note "Uploading $(wc -c <"$zip" | tr -d ' ') bytes..."
  http POST "/api/command-line/projects/create?$query" -H "Content-Type: application/zip" --data-binary "@$zip"
  http_ok
  read_created_project "$account"
  printf 'Created %s. It is publishing now.\n' "$P_REF"
  printf 'git: %s\n' "$CREATED_GIT_URL"

  if [ -n "$is_repo" ]; then
    # A repository with no commits yet takes the project's history.
    git -C "$abs" remote add "$remote" "$CREATED_GIT_URL" && printf 'Added the git remote "%s".\n' "$remote"
    printf 'To carry on here from the project'"'"'s first commit%s:\n  git fetch %s && git reset %s/main\n' \
      "$where" "$remote" "$remote"
  else
    # Without an OWNER/NAME, the folder is named by the project's account, which the list knows.
    if [ "$P_FULL" = "-" ] && [ -z "$P_ACCOUNT" ] && (resolve_project "$P_ID" >/dev/null 2>&1); then
      resolve_project "$P_ID"
    fi
    if [ "$P_FULL" != "-" ] || [ -n "$P_ACCOUNT" ]; then
      printf 'To work on it with git: cloudchef repo clone %s  (clones into %s)\n' "$P_REF" "$(default_clone_path)"
    else
      printf 'To work on it with git: cloudchef repo clone %s\n' "$P_REF"
    fi
  fi
  printf 'Follow the publish: cloudchef run watch --project %s\n' "$P_REF"
}

PUBLIC_NOTE="Anyone signed in to CloudChef can find, read and copy a public project."

cmd_repo_edit() {
  local project="" visibility="" accepted="" answer
  while [ $# -gt 0 ]; do
    case "$1" in
      --visibility) need_value "$1" $#; visibility="$2"; shift ;;
      --visibility=*) visibility="${1#--visibility=}" ;;
      --accept-visibility-change-consequences) accepted=1 ;;
      -*) die "Unknown flag: $1. See: cloudchef repo edit --help" ;;
      *) [ -z "$project" ] || die "Too many arguments."; project="$1" ;;
    esac
    shift
  done
  case "$visibility" in
    public | private) ;;
    "") die "Nothing to change. Use --visibility public or --visibility private." ;;
    *) die "--visibility is public or private, not \"$visibility\"." ;;
  esac
  resolve_project "$project"
  if [ "$visibility" = "public" ] && [ -z "$accepted" ]; then
    note "$PUBLIC_NOTE"
    if [ -t 0 ]; then
      printf 'Make %s public? [y/N] ' "$P_REF" >&2
      read -r answer || answer=""
      case "$answer" in
        y | Y | yes | YES | Yes) ;;
        *) die "Left $P_REF as it was." ;;
      esac
    else
      die "To make $P_REF public, add --accept-visibility-change-consequences."
    fi
  elif [ "$visibility" = "public" ]; then
    note "$PUBLIC_NOTE"
  fi
  api_post_json /api/command-line/projects/visibility \
    "{\"project\":\"$(json_escape "$P_ID")\",\"visibility\":\"$visibility\"}"
  visibility="$(json_field visibility "$HTTP_BODY")"
  printf '%s is now %s.\n' "$P_REF" "${visibility:-updated}"
}

cmd_repo_fork() {
  local project="" name="" account="" clone="" body id full gitUrl upstream dir
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) need_value "$1" $#; name="$2"; shift ;;
      --name=*) name="${1#--name=}" ;;
      --account) need_value "$1" $#; account="$2"; shift ;;
      --account=*) account="${1#--account=}" ;;
      --clone) clone=1 ;;
      --clone=true) clone=1 ;;
      --clone=false) clone="" ;;
      -*) die "Unknown flag: $1. See: cloudchef repo fork --help" ;;
      *) [ -z "$project" ] || die "Too many arguments."; project="$1" ;;
    esac
    shift
  done
  resolve_project "$project"
  upstream="$(git_url)"
  body="{\"project\":\"$(json_escape "$P_ID")\""
  [ -z "$name" ] || body="$body,\"name\":\"$(json_escape "$name")\""
  [ -z "$account" ] || body="$body,\"account\":\"$(json_escape "$account")\""
  body="$body}"
  note "Copying $P_REF into ${account:-your Personal account}. This can take a minute..."
  api_post_json /api/command-line/projects/copy "$body"
  id="$(json_field id "$HTTP_BODY")"
  full="$(json_field fullName "$HTTP_BODY")"
  gitUrl="$(json_field gitUrl "$HTTP_BODY")"
  [ -n "$id" ] || die "The server didn't say which project it made."
  P_ID="$id" P_FULL="${full:--}" P_NAME="$(json_field name "$HTTP_BODY")" P_ACCOUNT="${account:-Personal}"
  if [ -n "$full" ]; then P_REF="$full"; else P_REF="$id"; fi
  [ -n "$gitUrl" ] || gitUrl="$(git_url)"
  printf 'Created %s\n' "$P_REF"
  printf 'git: %s\n' "$gitUrl"
  [ -n "$clone" ] || return 0
  dir="$(default_clone_path)"
  mkdir -p "$(dirname "$dir")" || die "Could not create $(dirname "$dir")."
  git clone "$gitUrl" "$dir" || exit 1
  git -C "$dir" remote add upstream "$upstream" 2>/dev/null || true
  printf 'Cloned %s into %s (the original is the git remote "upstream")\n' "$P_REF" "$dir"
}

REWRITE_NOTE="main's history becomes the branch's: the commits only main has now are dropped from it.
Every other copy of the project (other clones, other people's computers, workspaces in CloudChef)
still has the old history and must be cloned again, or reset to the new main, before it can push.
The site then publishes the new main."

# remote_heads URL: the branches of the git repository at URL, as git ls-remote prints them, read with the cloudchef
# token whether or not git was set up to sign in through cloudchef.
remote_heads() {
  git -c "credential.$HOST.helper=" -c "credential.$HOST.helper=!$(self_command) auth git-credential" \
    -c "credential.$HOST.username=cloudchef" ls-remote --heads "$1"
}

# A push only ever adds to main; this replaces main's history with a branch's on purpose (to drop large files from old
# commits, say). main moves only from the commit read here, so work pushed to main meanwhile is never lost.
cmd_repo_rewrite_main() {
  local branch="" project="" accepted="" answer heads main commit published
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) need_value "$1" $#; project="$2"; shift ;;
      --project=*) project="${1#--project=}" ;;
      --accept-history-rewrite) accepted=1 ;;
      -*) die "Unknown flag: $1. See: cloudchef repo rewrite-main --help" ;;
      *) [ -z "$branch" ] || die "Too many arguments."; branch="$1" ;;
    esac
    shift
  done
  [ -n "$branch" ] || die "Name the branch whose history main should become: cloudchef repo rewrite-main BRANCH"
  branch="${branch#refs/heads/}"
  [ "$branch" != "main" ] || die "Name the branch that holds the new history, not main itself."
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "\"$branch\" can't be the name of a branch."
  resolve_project "$project"
  [ "$P_ROLE" = "edit" ] || die "You can't change $P_REF. Only its owner can rewrite its main."
  heads="$(remote_heads "$(git_url)")" || die "Couldn't read the branches of $P_REF. Try again."
  main="$(printf '%s\n' "$heads" | awk -v ref=refs/heads/main '$2 == ref { print $1 }')"
  commit="$(printf '%s\n' "$heads" | awk -v ref="refs/heads/$branch" '$2 == ref { print $1 }')"
  [ -n "$main" ] || die "$P_REF has no main yet, so there's nothing to rewrite: push to main instead."
  [ -n "$commit" ] || die "$P_REF has no branch \"$branch\". Push the new history to it first: git push REMOTE HEAD:$branch"
  [ "$commit" != "$main" ] || die "main of $P_REF is already at $branch (${commit:0:7})."
  note "This replaces main of $P_REF (now ${main:0:7}) with the branch $branch (${commit:0:7})."
  note "$REWRITE_NOTE"
  if [ -z "$accepted" ]; then
    if [ -t 0 ]; then
      printf 'Type %s to confirm: ' "$P_REF" >&2
      read -r answer || answer=""
      [ "$answer" = "$P_REF" ] || die "Left main of $P_REF as it was."
    else
      die "To rewrite main of $P_REF, add --accept-history-rewrite."
    fi
  fi
  api_post_json /api/command-line/projects/rewrite-main \
    "{\"project\":\"$(json_escape "$P_ID")\",\"branch\":\"$(json_escape "$branch")\",\"commit\":\"$commit\",\"expected\":\"$main\"}"
  printf 'main of %s is now %s (it was %s). It is publishing now.\n' "$P_REF" "${commit:0:7}" "${main:0:7}"
  [ "$(json_field recorded "$HTTP_BODY")" != "false" ] || note "CloudChef couldn't keep its record of this rewrite."
  published="$(json_field publishedBy "$HTTP_BODY")"
  [ "$published" != "cloudchef" ] || printf 'Follow the publish: cloudchef run watch --project %s\n' "$P_REF"
  printf 'Every copy, this one included, still has the old main. In each: git fetch, then on its main branch\n'
  printf 'git reset --hard REMOTE/main (commits there that were never pushed are dropped), or clone it again.\n'
}

cmd_repo() {
  local sub="$1"
  [ $# -gt 0 ] && shift
  if [ -z "$sub" ] || [ "$sub" = "-h" ] || [ "$sub" = "--help" ]; then usage repo; return 0; fi
  if wants_help "$@"; then usage "repo $sub" || usage repo; return 0; fi
  case "$sub" in
    list | ls) cmd_repo_list "$@" ;;
    view) cmd_repo_view "$@" ;;
    clone) cmd_repo_clone "$@" ;;
    create) cmd_repo_create "$@" ;;
    edit) cmd_repo_edit "$@" ;;
    fork) cmd_repo_fork "$@" ;;
    rewrite-main) cmd_repo_rewrite_main "$@" ;;
    *) die "Unknown command: repo $sub. See: cloudchef help repo" ;;
  esac
}

# ---------- run ----------

# parse_run_args ARGS: sets RUN_ARG PROJECT_ARG LOG_FLAG JSON_FLAG INTERVAL.
parse_run_args() {
  RUN_ARG="" PROJECT_ARG="" LOG_FLAG="" JSON_FLAG="" INTERVAL=5
  while [ $# -gt 0 ]; do
    case "$1" in
      # -R and --repo as gh spells them.
      --project | -p | --repo | -R) need_value "$1" $#; PROJECT_ARG="$2"; shift ;;
      --project=* | --repo=*) PROJECT_ARG="${1#*=}" ;;
      --log) LOG_FLAG=1 ;;
      --json) JSON_FLAG=1 ;;
      --interval | -i) need_value "$1" $#; INTERVAL="$2"; shift ;;
      --interval=*) INTERVAL="${1#--interval=}" ;;
      -*) die "Unknown flag: $1" ;;
      *) [ -z "$RUN_ARG" ] || die "Too many arguments."; RUN_ARG="$1" ;;
    esac
    shift
  done
  case "$INTERVAL" in '' | *[!0-9]*) die "--interval needs a number of seconds." ;; esac
}

cmd_run_list() {
  parse_run_args "$@"
  [ -z "$LOG_FLAG" ] || die "run list has no --log; use run view --log."
  resolve_project "${PROJECT_ARG:-$RUN_ARG}"
  if [ -n "$JSON_FLAG" ]; then
    api_get "/api/command-line/runs?project=$(urlencode "$P_ID")"
    printf '%s\n' "$HTTP_BODY"
    return 0
  fi
  runs_tsv "$P_ID"
  if ! find_run ""; then
    printf 'No publishes of %s yet.\n' "$P_REF"
    return 0
  fi
  {
    printf 'STATE\tKIND\tBRANCH\tCOMMIT\tUPDATED\tID\n'
    printf '%s\n' "$RUNS_TSV" | awk -F '\t' 'NF >= 6 && $6 != "id" { $4 = substr($4, 1, 7); print }' OFS='\t'
  } | print_table
}

need_run() {
  runs_tsv "$P_ID"
  if ! find_run "$1"; then
    [ -n "$1" ] && die "No publish $1 of $P_REF. See: cloudchef run list $P_REF"
    die "No publishes of $P_REF yet."
  fi
}

cmd_run_view() {
  parse_run_args "$@"
  resolve_project "$PROJECT_ARG"
  need_run "$RUN_ARG"
  if [ -n "$LOG_FLAG" ]; then
    api_get "/api/command-line/log?project=$(urlencode "$P_ID")&deployment=$(urlencode "$R_ID")"
    printf '%s' "$HTTP_BODY"
    case "$HTTP_BODY" in *"$NL") ;; "") ;; *) printf '\n' ;; esac
    return 0
  fi
  printf 'project:  %s\n' "$P_REF"
  printf 'state:    %s\n' "$R_STATE"
  printf 'kind:     %s\n' "$R_KIND"
  printf 'branch:   %s\n' "$R_BRANCH"
  printf 'commit:   %s\n' "${R_COMMIT:0:7}"
  printf 'updated:  %s\n' "$R_UPDATED"
  printf 'id:       %s\n' "$R_ID"
  if [ "$R_STATE" = "failed" ]; then
    printf '\nRead its log: cloudchef run view %s --project %s --log\n' "$R_ID" "$P_REF"
  fi
}

cmd_run_watch() {
  local head="" last="" waited=0 found
  parse_run_args "$@"
  resolve_project "$PROJECT_ARG"
  # Inside a clone of the project, wait for the publish of its current commit, which may not have started yet.
  if [ -z "$RUN_ARG" ] && remote_is_project; then
    head="$(git rev-parse HEAD 2>/dev/null)"
  fi
  while :; do
    runs_tsv "$P_ID"
    found=""
    if [ -n "$RUN_ARG" ]; then
      find_run "$RUN_ARG" && found=1
      [ -n "$found" ] || die "No publish $RUN_ARG of $P_REF."
    elif [ -n "$head" ]; then
      if find_run_for_commit "$head"; then
        found=1
      elif [ "$waited" -ge 120 ]; then
        note "No publish of ${head:0:7} has started after ${waited}s; watching the newest publish instead."
        head=""
        continue
      else
        [ "$last" = "waiting" ] || printf 'Waiting for a publish of %s to start...\n' "${head:0:7}"
        last="waiting"
      fi
    else
      find_run "" && found=1
      [ -n "$found" ] || die "No publishes of $P_REF yet."
    fi
    if [ -n "$found" ]; then
      if [ "$R_STATE" != "$last" ]; then
        printf '%s  %s  %s %s %s\n' "$(date +%H:%M:%S)" "$R_STATE" "$R_KIND" "$R_BRANCH" "${R_COMMIT:0:7}"
        last="$R_STATE"
      fi
      if is_finished "$R_STATE"; then
        if [ "$R_STATE" = "succeeded" ]; then
          [ "$R_KIND" != "production" ] || [ "$(dash_to_empty "$P_SITE")" = "" ] || printf 'Live at %s\n' "$P_SITE"
          return 0
        fi
        printf 'Read its log: cloudchef run view %s --project %s --log\n' "$R_ID" "$P_REF"
        return 1
      fi
    fi
    sleep "$INTERVAL"
    waited=$((waited + INTERVAL))
    [ "$INTERVAL" -gt 0 ] || waited=$((waited + 1))
  done
}

cmd_run_rerun() {
  local id
  parse_run_args "$@"
  resolve_project "$PROJECT_ARG"
  need_run "$RUN_ARG"
  api_post_json /api/command-line/runs/rerun \
    "{\"project\":\"$(json_escape "$P_ID")\",\"deployment\":\"$(json_escape "$R_ID")\"}"
  id="$(json_field id "$HTTP_BODY")"
  printf 'Started publish %s of %s (%s). Follow it: cloudchef run watch %s --project %s\n' \
    "$id" "$P_REF" "${R_COMMIT:0:7}" "$id" "$P_REF"
}

cmd_run() {
  local sub="$1"
  [ $# -gt 0 ] && shift
  if [ -z "$sub" ] || [ "$sub" = "-h" ] || [ "$sub" = "--help" ]; then usage run; return 0; fi
  if wants_help "$@"; then usage "run $sub" || usage run; return 0; fi
  case "$sub" in
    list | ls) cmd_run_list "$@" ;;
    view) cmd_run_view "$@" ;;
    watch) cmd_run_watch "$@" ;;
    rerun) cmd_run_rerun "$@" ;;
    *) die "Unknown command: run $sub. See: cloudchef help run" ;;
  esac
}

# ---------- browse, api, config, skill ----------

cmd_browse() {
  local project="" print_only="" url
  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help) usage browse; return 0 ;;
      -n | --no-browser) print_only=1 ;;
      -*) die "Unknown flag: $1" ;;
      *) project="$1" ;;
    esac
    shift
  done
  resolve_project "$project"
  url="$(dash_to_empty "$P_SITE")"
  [ -n "$url" ] || url="$HOST/"
  if [ -n "$print_only" ]; then
    printf '%s\n' "$url"
  else
    printf 'Opening %s\n' "$url"
    open_url "$url"
  fi
}

cmd_api() {
  local path="" method="" data="" have_data=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help) usage api; return 0 ;;
      -X | --method) need_value "$1" $#; method="$2"; shift ;;
      -d | --data) need_value "$1" $#; data="$2"; have_data=1; shift ;;
      -*) die "Unknown flag: $1" ;;
      *) [ -z "$path" ] || die "Too many arguments."; path="$1" ;;
    esac
    shift
  done
  [ -n "$path" ] || die "Name a path, like: cloudchef api /api/command-line/projects"
  case "$path" in /*) ;; *) path="/$path" ;; esac
  [ -n "$method" ] || { [ -n "$have_data" ] && method=POST || method=GET; }
  require_token
  if [ -n "$have_data" ]; then
    http "$method" "$path" -H "Content-Type: application/json" --data-binary "$data"
  else
    http "$method" "$path"
  fi
  printf '%s' "$HTTP_BODY"
  case "$HTTP_BODY" in *"$NL") ;; "") ;; *) printf '\n' ;; esac
  case "$HTTP_STATUS" in
    2??) return 0 ;;
    401) die "HTTP 401. Run: cloudchef auth login" ;;
    *) die "HTTP $HTTP_STATUS" ;;
  esac
}

config_key_ok() {
  case "$1" in
    clone-dir) return 0 ;;
  esac
  die "Unknown setting: $1. See: cloudchef config --help"
}

cmd_config() {
  local sub="$1" value
  [ $# -gt 0 ] && shift
  if [ -z "$sub" ] || wants_help "$sub" "$@"; then usage config; return 0; fi
  case "$sub" in
    get)
      [ $# -eq 1 ] || die "Usage: cloudchef config get KEY"
      config_key_ok "$1"
      value="$(config_get "$1")"
      printf '%s\n' "${value:-$DEFAULT_CLONE_DIR}"
      ;;
    set)
      [ $# -eq 2 ] || die "Usage: cloudchef config set KEY VALUE"
      config_key_ok "$1"
      case "$2" in *"$NL"*) die "A setting is one line." ;; esac
      config_set "$1" "$2"
      ;;
    list)
      value="$(config_get clone-dir)"
      printf 'clone-dir=%s\n' "${value:-$DEFAULT_CLONE_DIR}"
      ;;
    *) die "Unknown command: config $sub. See: cloudchef help config" ;;
  esac
}

skill_text() {
  cat <<'CLOUDCHEF_SKILL_END'
---
name: cloudchef
description: Work on CloudChef (cloudchef.build) projects from this computer with the `cloudchef` command - list, clone and copy projects, make one public or private, publish changes by pushing to main, preview a branch, wait for a publish to finish, and read a publish log to fix a failed one. Use when the user mentions CloudChef or cloudchef.build, or when the current git repository has a remote on a CloudChef host, such as https://cloudchef.build/ferdous/alberta-plan-glossary.git.
---

# CloudChef

CloudChef keeps each project as a git repository and publishes it to the project owner's Cloudflare account. The
`cloudchef` command works with CloudChef the way `gh` works with GitHub. Run `cloudchef help` for every command.

## Projects are git repositories

- A project is named `owner/name`, like `ferdous/alberta-plan-glossary`, and its git address is
  `https://cloudchef.build/ferdous/alberta-plan-glossary.git`.
- `cloudchef repo list` lists the projects you can use: name, account, your role (view or edit), whether it is public
  or private, last publish, site.
- `cloudchef repo clone ferdous/alberta-plan-glossary` clones one into `~/cloudflare/ferdous/alberta-plan-glossary`
  (change the folder with `cloudchef config set clone-dir PATH`, or pass a folder as the second argument). Just the
  name works too when only one of your projects has it.
- Git signs in through `cloudchef` (set up by `cloudchef auth login`), so plain `git pull` and `git push` work.
- Pushing to `main` publishes the project to its live site.
- Pushing any other branch builds a preview of that branch and leaves the live site alone.
- With the view role you can clone and pull but not push.
- A push only adds to `main`'s history: one that would rewrite it is refused (`git pull`, then push again). When the
  project's owner means to rewrite it (to drop large files from old commits, say), push the rewritten history to a
  branch, then run `cloudchef repo rewrite-main BRANCH`: main becomes that branch's history and publishes. Only the
  owner (for a team's project, one of its admins) can; it asks to type the project's name, or needs
  `--accept-history-rewrite` when not run in a terminal, so ask the user before passing it. Every other copy of the
  project must then be cloned again or reset to the new main.
- `cloudchef repo create NAME --push`, run in a git repository, makes a new project from it with its whole history:
  it adds the git remote `cloudchef` and pushes the current commit to the project's `main`, which publishes it (then
  `cloudchef run watch`). Without `--push` the project stays empty until `git push -u cloudchef HEAD:main`.
  `--remote NAME` names the remote, `--account ACCOUNT` picks the account, `--source DIR` another folder. A folder
  that isn't a git repository (or has no commits) is uploaded as files instead, and publishes by itself.

## Public projects

- A public project can be found, read and copied by anyone signed in to CloudChef. Only people with the edit role on it can push.
- `cloudchef repo list --public` lists everyone's public projects. `cloudchef repo view OWNER/NAME` and
  `cloudchef repo clone OWNER/NAME` work for them too (read only: clone and pull, no push).
- `cloudchef repo fork OWNER/NAME` copies a project, with its history, into a new project of your own and prints its
  name; `--name NAME` names the copy, `--account ACCOUNT` picks the account (default Personal), and `--clone` clones the
  copy with the original as the git remote `upstream`. Copying can take a minute. Change and push the copy, not the
  original.
- `cloudchef repo edit OWNER/NAME --visibility public` makes a project public and `--visibility private` makes it
  private again. Making one public needs `--accept-visibility-change-consequences`; ask the user before passing it,
  since everyone signed in can then read and copy the code.

## After a push

1. `cloudchef run watch` waits for the publish of what you pushed. It exits 0 when the publish succeeded and 1 when it
   failed.
2. When it failed, `cloudchef run view --log` prints the publish log. Find the error, fix it, commit, push, and watch
   again.
3. `cloudchef run rerun` publishes the same commit again, for failures the code didn't cause (a timeout, a service
   outage).
4. `cloudchef browse` opens the live site.

Run these inside the clone. Elsewhere, name the project: `cloudchef run watch --project ferdous/alberta-plan-glossary`.

## Secrets

- API keys and other secrets belong in Cloudflare (the project's Worker secrets), never in files in the repository.
- `.env` and `.dev.vars` files aren't pushed; keep them listed in `.gitignore`.
- Never print, log, commit, or paste the CloudChef token (`cloudchef auth token`, `~/.config/cloudchef/token`, or
  `CLOUDCHEF_TOKEN`). Git gets it from `cloudchef` by itself.
CLOUDCHEF_SKILL_END
}

write_skill() {
  # shellcheck disable=SC2015 # either step failing is the same failure
  mkdir -p "$1/cloudchef" && skill_text >"$1/cloudchef/SKILL.md" || die "Could not write $1/cloudchef/SKILL.md."
  printf 'Installed the cloudchef skill: %s\n' "$1/cloudchef/SKILL.md"
}

# Whether DIR is a real folder (not a link) holding nothing but a cloudchef SKILL.md, so removing it loses nothing.
holds_only_our_skill() {
  local dir="$1" entry
  [ -d "$dir" ] && [ ! -L "$dir" ] || return 1
  for entry in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    [ "$entry" = "$dir/SKILL.md" ] || return 1
  done
  [ -f "$dir/SKILL.md" ] && [ ! -L "$dir/SKILL.md" ] && grep -qx 'name: cloudchef' "$dir/SKILL.md"
}

remove_our_skill() {
  rm -f "$1/SKILL.md" && rmdir "$1"
}

# Claude Code reads only ~/.claude/skills, so its cloudchef skill is a link to the one copy in ~/.agents/skills. An
# existing link or earlier copy of the skill is replaced; anything else there is left alone.
link_claude_skill() {
  local real="$HOME/.agents/skills/cloudchef" link="$HOME/.claude/skills/cloudchef"
  if [ -L "$link" ]; then
    rm -f "$link" || die "Could not replace the link $link."
  elif [ -e "$link" ]; then
    if [ "$(cd "$link" 2>/dev/null && pwd -P)" = "$(cd "$real" && pwd -P)" ]; then
      return 0 # ~/.claude/skills and ~/.agents/skills are already the same folder.
    fi
    if ! holds_only_our_skill "$link"; then
      note "Left $link alone: it holds more than the cloudchef skill. Remove it and run cloudchef skill install again to link Claude Code to $real."
      return 0
    fi
    remove_our_skill "$link" || die "Could not replace the earlier copy $link."
  fi
  # shellcheck disable=SC2015 # either step failing is the same failure
  mkdir -p "$HOME/.claude/skills" && ln -s "$real" "$link" || die "Could not link $link to $real."
  printf 'Linked %s -> %s\n' "$link" "$real"
}

# The skill is one Agent Skills folder (cloudchef/SKILL.md) in ~/.agents/skills, which Codex, OpenCode and other agents
# read, linked into Claude Code's ~/.claude/skills when Claude Code is installed.
cmd_skill() {
  local sub="$1" dir=""
  [ $# -gt 0 ] && shift
  if [ -z "$sub" ] || wants_help "$sub" "$@"; then usage skill; return 0; fi
  [ "$sub" = "install" ] || die "Unknown command: skill $sub. See: cloudchef help skill"
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) need_value "$1" $#; dir="$(expand_home "$2")"; shift ;;
      --dir=*) dir="$(expand_home "${1#--dir=}")" ;;
      *) die "Unknown argument: $1" ;;
    esac
    shift
  done
  if [ -n "$dir" ]; then
    write_skill "$dir"
    return 0
  fi
  write_skill "$HOME/.agents/skills"
  [ ! -d "$HOME/.claude" ] || link_claude_skill
  # Earlier versions also copied it to ~/.codex/skills, which Codex doesn't read.
  if holds_only_our_skill "$HOME/.codex/skills/cloudchef"; then
    remove_our_skill "$HOME/.codex/skills/cloudchef" &&
      printf 'Removed the earlier copy %s (Codex reads ~/.agents/skills)\n' "$HOME/.codex/skills/cloudchef"
  fi
}

# ---------- main ----------

main() {
  local cmd="$1"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    "" | -h | --help) usage "" ;;
    help)
      if [ $# -eq 0 ]; then usage ""; else usage "$*" || usage "$1" || die "No help for: $*"; fi
      ;;
    --version | version) printf 'cloudchef %s\n' "$CLOUDCHEF_VERSION" ;;
    auth) cmd_auth "$@" ;;
    repo) cmd_repo "$@" ;;
    run) cmd_run "$@" ;;
    browse) cmd_browse "$@" ;;
    api) cmd_api "$@" ;;
    config) cmd_config "$@" ;;
    skill) cmd_skill "$@" ;;
    *) die "Unknown command: $cmd. See: cloudchef help" ;;
  esac
}

main "$@"
