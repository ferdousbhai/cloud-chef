#!/usr/bin/env bash
# cloudchef: work on CloudChef projects from your own computer, the way gh works with GitHub.
# Needs only bash (3.2 or later), curl and git. Install: curl -fsSL https://cloudchef.build/install.sh | bash
set -o pipefail

CLOUDCHEF_VERSION="0.1.0"
HOST="${CLOUDCHEF_HOST:-https://cloudchef.build}"
HOST="${HOST%/}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cloudchef"
TOKEN_FILE="$CONFIG_DIR/token"
CONFIG_FILE="$CONFIG_DIR/config"
# shellcheck disable=SC2088 # kept literal: it is shown to people and expanded where it is used
DEFAULT_CLONE_DIR="~/cloudflare"
TAB="$(printf '\t')"
NL='
'

# ---------- output ----------

die() {
  printf 'cloudchef: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*" >&2
}

# ---------- small helpers ----------

# The host's name without the scheme, as people say it (cloudchef.build).
host_display() {
  local h="${HOST#*://}"
  printf '%s' "${h%%/*}"
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$TAB/\\t}"
  s="${s//$NL/\\n}"
  printf '%s' "$s"
}

# json_field KEY JSON: the first scalar value of KEY anywhere in JSON (strings unescaped simply; null is empty).
# Only for the few flat fields this tool reads; it is not a JSON parser.
json_field() {
  local key="$1" raw bs q
  bs="$(printf '\001')"
  q="$(printf '\002')"
  raw="$(printf '%s' "$2" | tr '\n\r' '  ' |
    sed -e "s/\\\\\\\\/$bs/g" -e "s/\\\\\"/$q/g" |
    grep -oE "\"$key\"[[:space:]]*:[[:space:]]*(\"[^\"]*\"|[^],}\"[:space:]]+)" | head -n 1)"
  [ -n "$raw" ] || return 0
  raw="${raw#*:}"
  raw="$(printf '%s' "$raw" | sed -e 's/^[[:space:]]*//')"
  case "$raw" in
    \"*)
      raw="${raw#\"}"
      raw="${raw%\"}"
      ;;
    null) raw="" ;;
  esac
  printf '%s' "$raw" | sed -e 's#\\/#/#g' -e 's/\\n/ /g' -e 's/\\t/ /g' -e "s/$q/\"/g" -e "s/$bs/\\\\/g"
}

urlencode() {
  local s="$1" out="" c i
  local LC_ALL=C
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out="$out$c" ;;
      *) out="$out$(printf '%%%02X' "'$c")" ;;
    esac
  done
  printf '%s' "$out"
}

# A folder-safe form of a name: lowercase, anything outside [a-z0-9._-] becomes '-', repeats collapse, ends trimmed.
folder_safe() {
  local s
  s="$(printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' |
    LC_ALL=C sed -e 's/[^a-z0-9._-]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//')"
  case "$s" in
    "" | . | ..) s="project" ;;
  esac
  printf '%s' "$s"
}

expand_home() {
  # shellcheck disable=SC2088 # matching a literal ~/ to expand it
  case "$1" in
    "~") printf '%s' "$HOME" ;;
    "~/"*) printf '%s/%s' "$HOME" "${1#"~/"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

open_url() {
  local url="$1" opener="${CLOUDCHEF_BROWSER:-}"
  if [ -z "$opener" ]; then
    if command -v open >/dev/null 2>&1 && [ "$(uname -s)" = "Darwin" ]; then
      opener=open
    elif command -v xdg-open >/dev/null 2>&1; then
      opener=xdg-open
    else
      return 0
    fi
  fi
  ($opener "$url" >/dev/null 2>&1 &) 2>/dev/null
  return 0
}

print_table() {
  # stdin: tab-separated rows, the first being the header.
  if command -v column >/dev/null 2>&1; then
    column -t -s "$TAB"
  else
    awk -F '\t' '{ rows[NR] = $0; for (i = 1; i <= NF; i++) if (length($i) > w[i]) w[i] = length($i); if (NF > n) n = NF }
      END { for (r = 1; r <= NR; r++) { c = split(rows[r], f, "\t"); line = "";
        for (i = 1; i <= c; i++) line = line (i < c ? sprintf("%-" w[i] "s  ", f[i]) : f[i]); print line } }'
  fi
}

# ---------- config ----------

config_get() {
  [ -f "$CONFIG_FILE" ] || return 0
  grep -E "^$1=" "$CONFIG_FILE" | tail -n 1 | sed -e "s/^$1=//"
}

config_set() {
  local tmp
  (umask 077 && mkdir -p "$CONFIG_DIR") || die "Could not create $CONFIG_DIR."
  tmp="$CONFIG_FILE.tmp.$$"
  # shellcheck disable=SC2015 # either step failing is the same failure
  { [ -f "$CONFIG_FILE" ] && grep -vE "^$1=" "$CONFIG_FILE"; printf '%s=%s\n' "$1" "$2"; } >"$tmp" &&
    mv "$tmp" "$CONFIG_FILE" || die "Could not write $CONFIG_FILE."
}

clone_base() {
  local base="${CLOUDCHEF_CLONE_DIR:-}"
  [ -n "$base" ] || base="$(config_get clone-dir)"
  [ -n "$base" ] || base="$DEFAULT_CLONE_DIR"
  expand_home "$base"
}

# ---------- token ----------

read_token() {
  if [ -n "${CLOUDCHEF_TOKEN:-}" ]; then
    printf '%s' "$CLOUDCHEF_TOKEN"
  elif [ -f "$TOKEN_FILE" ]; then
    tr -d ' \n\r' <"$TOKEN_FILE"
  fi
}

require_token() {
  TOKEN="$(read_token)"
  [ -n "$TOKEN" ] || die "Not logged in. Run: cloudchef auth login"
}

# ---------- HTTP ----------

# http METHOD PATH [curl args...]: sets HTTP_STATUS and HTTP_BODY. Sends the token when TOKEN is set; the token goes to
# curl on stdin (-K -), never on its command line.
http() {
  local method="$1" path="$2" out
  shift 2
  out="$( ([ -z "${TOKEN:-}" ] || printf 'header = "Authorization: Bearer %s"\n' "$TOKEN") |
    curl -sS -K - -X "$method" -H "User-Agent: cloudchef-cli/$CLOUDCHEF_VERSION" -w "${NL}%{http_code}" "$@" "$HOST$path")" ||
    die "Could not reach $HOST."
  HTTP_STATUS="${out##*"$NL"}"
  HTTP_BODY="${out%"$NL"*}"
}

http_ok() {
  case "$HTTP_STATUS" in
    2??) return 0 ;;
  esac
  local message
  message="$(json_field error "$HTTP_BODY")"
  if [ "$HTTP_STATUS" = "401" ]; then
    die "${message:-Not logged in.} Run: cloudchef auth login"
  fi
  [ -n "$message" ] || message="$(printf '%s' "$HTTP_BODY" | head -c 300)"
  die "${message:-The server answered HTTP $HTTP_STATUS.} (HTTP $HTTP_STATUS)"
}

# api_get PATH: an authenticated GET whose body lands in HTTP_BODY, failing on any non-2xx answer.
api_get() {
  require_token
  http GET "$1"
  http_ok
}

api_post_json() {
  require_token
  http POST "$1" -H "Content-Type: application/json" --data-binary "$2"
  http_ok
}

# ---------- projects ----------

projects_tsv() {
  api_get "/api/command-line/projects?format=tsv"
  PROJECTS_TSV="$HTTP_BODY"
}

# The current directory's CloudChef project, from its git remote: "full:<owner>/<slug>" for {host}/<owner>/<slug>.git,
# "id:<id>" for {host}/git/<id>.git, or nothing.
remote_project_ref() {
  local url path
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  git remote -v 2>/dev/null | while read -r _ url _; do
    case "$url" in
      "$HOST/"*) ;;
      *) continue ;;
    esac
    path="${url#"$HOST/"}"
    path="${path%/}"
    path="${path%.git}"
    case "$path" in
      */*/*) continue ;;
      git/*) printf 'id:%s\n' "${path#git/}" ;;
      */*) printf 'full:%s\n' "$path" ;;
      *) continue ;;
    esac
    break
  done
}

lowercase() {
  printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]'
}

# match_projects MODE VALUE: counts the projects in PROJECTS_TSV that match (M_COUNT), keeping the last match's row
# (M_ROW) and a line per match (M_CHOICES). MODE: id, full (OWNER/NAME, any case), account (ACCOUNT/NAME), or bare (the
# project's name, or the NAME of its OWNER/NAME).
match_projects() {
  local mode="$1" want="$2" want_lower name account role state site id full vis ok
  want_lower="$(lowercase "$want")"
  M_COUNT=0 M_ROW="" M_CHOICES=""
  while IFS="$TAB" read -r name account role state site id full vis; do
    [ -n "$id" ] && [ "$id" != "id" ] || continue
    [ -n "$full" ] || full="-"
    [ -n "$vis" ] || vis="-"
    ok=""
    case "$mode" in
      id) [ "$id" = "$want" ] && ok=1 ;;
      full) [ "$full" != "-" ] && [ "$(lowercase "$full")" = "$want_lower" ] && ok=1 ;;
      account) [ "$account/$name" = "$want" ] && ok=1 ;;
      bare)
        if [ "$name" = "$want" ]; then
          ok=1
        elif [ "$full" != "-" ] && [ "$(lowercase "${full#*/}")" = "$want_lower" ]; then
          ok=1
        fi
        ;;
    esac
    [ -n "$ok" ] || continue
    M_COUNT=$((M_COUNT + 1))
    M_ROW="$name$TAB$account$TAB$role$TAB$state$TAB$site$TAB$id$TAB$full$TAB$vis"
    if [ "$full" != "-" ]; then
      M_CHOICES="$M_CHOICES  $full  ($account)$NL"
    else
      M_CHOICES="$M_CHOICES  $id  ($account/$name)$NL"
    fi
  done <<EOF
$PROJECTS_TSV
EOF
}

# match_public MODE VALUE: like match_projects, over the public projects (Explore's TSV: full name, name, owner's name,
# site, id); MODE is full or id. A match's row has the
# project list's columns, with no role (you use it only as a public project) and the owner's name as its account.
match_public() {
  local mode="$1" want="$2" want_lower full name owner site id ok
  want_lower="$(lowercase "$want")"
  M_COUNT=0 M_ROW="" M_CHOICES=""
  # Only a fallback: when Explore can't be read, there is simply no public match.
  require_token
  http GET "/api/explore?format=tsv"
  case "$HTTP_STATUS" in
    2??) EXPLORE_TSV="$HTTP_BODY" ;;
    *) EXPLORE_TSV="" ;;
  esac
  while IFS="$TAB" read -r full name owner site id; do
    [ -n "$id" ] && [ "$id" != "id" ] || continue
    [ -n "$full" ] || full="-"
    ok=""
    case "$mode" in
      id) [ "$id" = "$want" ] && ok=1 ;;
      full) [ "$full" != "-" ] && [ "$(lowercase "$full")" = "$want_lower" ] && ok=1 ;;
    esac
    [ -n "$ok" ] || continue
    M_COUNT=$((M_COUNT + 1))
    M_ROW="$name$TAB$owner$TAB-$TAB-$TAB${site:--}$TAB$id$TAB$full${TAB}public"
    M_CHOICES="$M_CHOICES  $id  ($owner/$name)$NL"
  done <<EOF
$EXPLORE_TSV
EOF
}

use_match() {
  IFS="$TAB" read -r P_NAME P_ACCOUNT P_ROLE P_STATE P_SITE P_ID P_FULL P_VIS <<EOF
$M_ROW
EOF
  [ -n "$P_FULL" ] || P_FULL="-"
  [ -n "$P_VIS" ] || P_VIS="-"
  # How to name the project back to the person: its OWNER/NAME, else its id.
  if [ "$P_FULL" != "-" ]; then P_REF="$P_FULL"; else P_REF="$P_ID"; fi
}

# resolve_project [PROJECT]: sets P_NAME P_ACCOUNT P_ROLE P_STATE P_SITE P_ID P_FULL P_VIS P_REF. PROJECT is OWNER/NAME,
# a project name when only one project has it, ACCOUNT/NAME, or an id; without one, the current directory's git remote.
# An OWNER/NAME or id that isn't one of your projects can be a public project's (P_ROLE is then "-").
resolve_project() {
  local want="$1" ref
  if [ -z "$want" ]; then
    ref="$(remote_project_ref)"
    [ -n "$ref" ] || die "Name a project, or run this inside a clone of one. See: cloudchef repo list"
    projects_tsv
    case "$ref" in
      id:*) match_projects id "${ref#id:}" ;;
      full:*) match_projects full "${ref#full:}" ;;
    esac
    [ "$M_COUNT" -ge 1 ] || match_public "${ref%%:*}" "${ref#*:}"
    [ "$M_COUNT" -ge 1 ] || die "This folder's CloudChef project (${ref#*:}) isn't one you can use any more."
    use_match
    return 0
  fi
  projects_tsv
  case "$want" in
    */*)
      match_projects full "$want"
      [ "$M_COUNT" -ge 1 ] || match_projects account "$want"
      [ "$M_COUNT" -ge 1 ] || match_public full "$want"
      ;;
    *)
      match_projects bare "$want"
      [ "$M_COUNT" -ge 1 ] || match_projects id "$want"
      [ "$M_COUNT" -ge 1 ] || match_public id "$want"
      ;;
  esac
  if [ "$M_COUNT" -eq 0 ]; then
    die "No project \"$want\". See: cloudchef repo list, or cloudchef repo list --public"
  elif [ "$M_COUNT" -gt 1 ]; then
    die "Several projects are called \"$want\". Name one of them:$NL${M_CHOICES%"$NL"}"
  fi
  use_match
}

# Whether the current directory's git remote is the resolved project.
remote_is_project() {
  local ref
  ref="$(remote_project_ref)"
  case "$ref" in
    "id:$P_ID") return 0 ;;
    full:*) [ "$P_FULL" != "-" ] && [ "$(lowercase "${ref#full:}")" = "$(lowercase "$P_FULL")" ] && return 0 ;;
  esac
  return 1
}

# The resolved project's git address: {host}/<owner>/<name>.git, or {host}/git/<id>.git before it has one.
git_url() {
  if [ "$P_FULL" != "-" ]; then
    printf '%s/%s.git' "$HOST" "$P_FULL"
  else
    printf '%s/git/%s.git' "$HOST" "$P_ID"
  fi
}

# Where repo clone puts the resolved project by default: <clone-dir>/<owner>/<name>, else <clone-dir>/<account>/<name>.
default_clone_path() {
  if [ "$P_FULL" != "-" ]; then
    printf '%s/%s/%s' "$(clone_base)" "$(folder_safe "${P_FULL%%/*}")" "$(folder_safe "${P_FULL#*/}")"
  else
    printf '%s/%s/%s' "$(clone_base)" "$(folder_safe "$P_ACCOUNT")" "$(folder_safe "$P_NAME")"
  fi
}

dash_to_empty() {
  [ "$1" = "-" ] || printf '%s' "$1"
}

# ---------- runs ----------

runs_tsv() {
  api_get "/api/command-line/runs?project=$(urlencode "$1")&format=tsv"
  RUNS_TSV="$HTTP_BODY"
}

# find_run RUN_ID|"" : sets R_STATE R_KIND R_BRANCH R_COMMIT R_UPDATED R_ID from RUNS_TSV (the newest without an id).
find_run() {
  local want="$1" state kind branch commit updated id
  R_ID=""
  while IFS="$TAB" read -r state kind branch commit updated id; do
    [ -n "$id" ] && [ "$id" != "id" ] || continue
    if [ -z "$want" ] || [ "$id" = "$want" ]; then
      R_STATE="$state" R_KIND="$kind" R_BRANCH="$branch" R_COMMIT="$commit" R_UPDATED="$updated" R_ID="$id"
      return 0
    fi
  done <<EOF
$RUNS_TSV
EOF
  return 1
}

# find_run_for_commit COMMIT: the newest run of that commit.
find_run_for_commit() {
  local want="$1" state kind branch commit updated id
  while IFS="$TAB" read -r state kind branch commit updated id; do
    [ -n "$id" ] && [ "$id" != "id" ] || continue
    if [ "${commit:0:7}" = "${want:0:7}" ]; then
      R_STATE="$state" R_KIND="$kind" R_BRANCH="$branch" R_COMMIT="$commit" R_UPDATED="$updated" R_ID="$id"
      return 0
    fi
  done <<EOF
$RUNS_TSV
EOF
  return 1
}

is_finished() {
  case "$1" in
    succeeded | failed | not_deployable) return 0 ;;
  esac
  return 1
}

# ---------- help ----------

usage() {
  case "$1" in
    "")
      cat <<EOF
Work on CloudChef projects from your own computer.

Usage: cloudchef <command> <subcommand> [flags]

Auth
  auth login           Sign in from the browser and set up git
  auth status          Show who you're signed in as
  auth logout          Remove the token from this computer
  auth token           Print the token
  auth setup-git       Let git sign in to CloudChef through cloudchef

Projects
  repo list            List the projects you can use (--public: everyone's public projects)
  repo view [PROJECT]  Show a project
  repo clone PROJECT   Clone a project
  repo create NAME     Make a new project from a repository or folder
  repo edit [PROJECT]  Make a project public or private
  repo fork PROJECT    Copy a project into your own account
  repo rewrite-main BRANCH  Replace a project's main with a branch's history (owner only)

Publishes
  run list [PROJECT]   List a project's publishes and previews
  run view [RUN_ID]    Show a publish, or its log with --log
  run watch [RUN_ID]   Wait for a publish to finish
  run rerun [RUN_ID]   Publish the same commit again

More
  browse [PROJECT]     Open a project's site
  api PATH             Make an authenticated request to the CloudChef API
  config               Read and change settings (clone-dir)
  skill install        Install the cloudchef skill for coding agents
  help [COMMAND]       Show help for a command
  --version            Show the version

PROJECT is OWNER/NAME (like ferdous/alberta-plan-glossary), or just NAME when only one project has it.
ACCOUNT/NAME and a project id work too, and OWNER/NAME also finds public projects. Inside a clone, PROJECT
defaults to that project.

Example: cloudchef repo clone ferdous/alberta-plan-glossary
Environment: CLOUDCHEF_HOST (default https://cloudchef.build), CLOUDCHEF_TOKEN, CLOUDCHEF_CLONE_DIR.
EOF
      ;;
    auth)
      cat <<EOF
Usage: cloudchef auth <login|status|logout|token|setup-git|git-credential>

  login           Sign in from the browser; saves a token and sets up git
  status          Show who you're signed in as
  logout          Remove the token from this computer
  token           Print the token (never paste it anywhere public)
  setup-git       Let git sign in to $(host_display) through cloudchef
  git-credential  The git credential helper (git runs it; you don't need to)
EOF
      ;;
    "auth login") echo "Usage: cloudchef auth login${NL}${NL}Shows a code, opens $HOST in the browser to approve this computer, saves the token to $TOKEN_FILE, and sets up git." ;;
    "auth status") echo "Usage: cloudchef auth status${NL}${NL}Shows who the token belongs to." ;;
    "auth logout") echo "Usage: cloudchef auth logout${NL}${NL}Deletes $TOKEN_FILE. Revoke the token in CloudChef too: Settings → Command line." ;;
    "auth token") echo "Usage: cloudchef auth token${NL}${NL}Prints the token. Keep it secret." ;;
    "auth setup-git") echo "Usage: cloudchef auth setup-git${NL}${NL}Sets cloudchef as git's credential helper for $HOST in your global git config." ;;
    "auth git-credential") echo "Usage: cloudchef auth git-credential <get|store|erase>${NL}${NL}The git credential helper protocol. Answers only for $HOST." ;;
    repo)
      cat <<EOF
Usage: cloudchef repo <list|view|clone|create|edit|fork|rewrite-main>

  list [--public] [--json]                         Your projects, or with --public everyone's public ones
  view [PROJECT] [--json] [--web]                  Show a project
  clone PROJECT [DIR] [-- GIT_FLAGS]               Clone a project
  create NAME [--source DIR] [--push]              Make a new project from a repository or folder
  edit [PROJECT] --visibility public|private       Make a project public or private
  fork PROJECT [--name N] [--account A] [--clone]  Copy a project into your own account
  rewrite-main BRANCH [--project PROJECT]          Replace main's history with a branch's (owner only)

PROJECT is OWNER/NAME, as in: cloudchef repo clone ferdous/alberta-plan-glossary
EOF
      ;;
    "repo list")
      cat <<EOF
Usage: cloudchef repo list [--public] [--json]

Lists the projects you can view or edit, in every account you use, by OWNER/NAME, with whether each is
public or private. --json includes each project's id and git address.

--public lists everyone's public projects instead (Explore). Anyone signed in can clone and copy those:
  cloudchef repo clone OWNER/NAME, cloudchef repo fork OWNER/NAME
EOF
      ;;
    "repo edit")
      cat <<EOF
Usage: cloudchef repo edit [PROJECT] --visibility public|private [--accept-visibility-change-consequences]

Makes a project public or private. $PUBLIC_NOTE
Making one public asks first; --accept-visibility-change-consequences answers yes (needed when not run
in a terminal). Only people who can change the project's settings can do this.
EOF
      ;;
    "repo rewrite-main")
      cat <<EOF
Usage: cloudchef repo rewrite-main BRANCH [--project PROJECT] [--accept-history-rewrite]

A push to main only ever adds to its history. This replaces main with BRANCH's history on purpose,
for example to drop large files from old commits: rewrite the history on your computer, push it to a
branch (git push REMOTE HEAD:BRANCH, which builds a preview), then run this.

$REWRITE_NOTE

Only the project's owner (for a team's project, one of the team's admins) can do this. It reads where
main and BRANCH are first and moves main only from there: if anyone pushes to main in between,
nothing changes. A secret file (.env, .dev.vars) never reaches main this way either.

It asks you to type the project's name; --accept-history-rewrite answers for you (needed when not run
in a terminal). Inside a clone, PROJECT defaults to that project.

Example: cloudchef repo rewrite-main slim --project ferdous/alberta-plan-glossary
EOF
      ;;
    "repo fork")
      cat <<EOF
Usage: cloudchef repo fork [PROJECT] [--name NAME] [--account ACCOUNT] [--clone]

Copies a project (yours, or anyone's public one) into a new project of your own, with its history, and
prints the new project's OWNER/NAME. Copying can take a minute.
  --name NAME        Name the copy (default: the original's name)
  --account ACCOUNT  Put the copy in this account (default: Personal)
  --clone            Clone the copy into <clone-dir>/<owner>/<name>, with the original as the remote "upstream"
EOF
      ;;
    "repo view") echo "Usage: cloudchef repo view [PROJECT] [--json] [--web]${NL}${NL}Shows a project's full name, account, your role, git address, site and last publish.${NL}Example: cloudchef repo view ferdous/alberta-plan-glossary${NL}--web opens the projects page." ;;
    "repo clone")
