{
  "name": "cloudchef-cloudflare-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "pnpm run verify:licenses && vite build && pnpm run verify:licenses:built",
    "preview": "vite preview --host 0.0.0.0",
    "agent:enable": "node scripts/enable-agent-capability.mjs && pnpm run licenses:generate",
    "deploy": "pnpm run typecheck && pnpm run verify:stack && pnpm run provision:production && pnpm run verify:production-config && pnpm run build && pnpm run lint && pnpm run d1:migrations:apply:production && cf deploy --prebuilt",
    "d1:migrations:apply:production": "node scripts/apply-d1-migrations.mjs",
    "cf-typegen": "node scripts/render-cloudflare-config.mjs && cf workers types --include-runtime false",
    "typecheck": "pnpm run cf-typegen && tsc -p . --noEmit --pretty false",
    "provision:production": "node scripts/provision-cloudflare-production.mjs",
    "verify:stack": "node scripts/verify-stack-alignment.mjs",
    "verify:licenses": "node scripts/verify-production-licenses.mjs",
    "verify:licenses:built": "node scripts/verify-production-licenses.mjs --built",
    "licenses:generate": "node scripts/verify-production-licenses.mjs --write-notices",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "lint": "eslint src vite.config.ts scripts/verify-production-licenses.mjs scripts/lib/runtime-module-security.ts scripts/lib/production-license-artifact.mjs --max-warnings=0"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@cloudflare/workers-types": "5.20261004.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "cf": "1.0.0-beta.12",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
