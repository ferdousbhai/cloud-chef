{
  "version": 1,
  "description": "Opt-in Cloudflare AppAgent and Workers AI capability; dependencies install at their latest release",
  "dependencies": [
    "@ai-sdk/provider",
    "@ai-sdk/react",
    "@cloudflare/ai-chat",
    "agents",
    "ai",
    "core-js-pure",
    "workers-ai-provider",
    "zod"
  ],
  "metadataOnlyPackageAllowlist": [
    "@ai-sdk/provider-utils",
    "@cfworker/json-schema",
    "@napi-rs/wasm-runtime",
    "@rolldown/binding-wasm32-wasi",
    "@tybys/wasm-util"
  ],
  "cloudflare": {
    "entrypoint": "src/server.ts",
    "agent": {
      "securityD1": {
        "name": "cloudchef-cloudflare-app-agent-security",
        "id": "00000000-0000-0000-0000-000000000000"
      }
    }
  },
  "typescriptExcludesToRemove": [
    "src/server.ts",
    "src/agent-routing.ts",
    "src/agent-security.ts",
    "src/agents"
  ]
}
