{
  "version": 1,
  "description": "Opt-in Cloudflare AppAgent and Workers AI capability",
  "dependencies": {
    "@ai-sdk/provider": "4.0.4",
    "@ai-sdk/react": "4.0.51",
    "@cloudflare/ai-chat": "0.10.1",
    "agents": "0.20.1",
    "ai": "7.0.48",
    "core-js-pure": "3.49.0",
    "partyserver": "0.5.9",
    "workers-ai-provider": "4.0.0",
    "zod": "4.4.3"
  },
  "metadataOnlyPackageAllowlist": [
    "@ai-sdk/provider-utils@5.0.18",
    "@cfworker/json-schema@4.1.1",
    "@cloudflare/workers-types@5.20260801.1",
    "partyserver@0.5.9"
  ],
  "cloudflare": {
    "entrypoint": "src/server.ts",
    "agent": {
      "securityD1": {
        "name": "cloudchef-cloudflare-app-agent-security",
        "id": "00000000-0000-0000-0000-000000000000"
      }
    }
  },
  "typescriptExcludesToRemove": [
    "src/server.ts",
    "src/agent-routing.ts",
    "src/agent-security.ts",
    "src/agents"
  ]
}
