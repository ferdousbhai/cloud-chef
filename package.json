{
  "name": "cloudchef",
  "description": "AI project builder for Cloudflare Workers",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://cloudchef.build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferdousbhai/cloud-chef.git"
  },
  "bugs": {
    "url": "https://github.com/ferdousbhai/cloud-chef/issues"
  },
  "type": "module",
  "version": "0.0.7",
  "scripts": {
    "workers-builds:build": "pnpm install --frozen-lockfile && node scripts/check-workers-builds-environment.mjs && pnpm run generate && node scripts/deploy-production.mjs --check-workers-builds",
    "workers-builds:deploy": "node scripts/deploy-production.mjs --workers-builds",
    "build": "pnpm run generate && pnpm run build:check",
    "build:check": "vite build",
    "release:build": "pnpm run build:check && pnpm run verify:built-ssr && pnpm run verify:static-assets && pnpm run bundle:check",
    "build:analyze": "pnpm run build && pnpm run bundle:report",
    "bundle:check": "node scripts/report-client-bundle.mjs --max-raw-kb=500 --max-total-gzip-kb=1300 --max-total-brotli-kb=1100 --limit=15",
    "bundle:report": "node scripts/report-client-bundle.mjs",
    "audit:dependencies": "pnpm audit --audit-level moderate",
    "sbom:production": "node scripts/verify-production-licenses.mjs --spdx",
    "licenses:generate": "node scripts/verify-production-licenses.mjs --write-notices",
    "d1:bookmark:production": "node scripts/record-d1-time-travel-bookmark.mjs",
    "d1:migrations:apply:local": "node scripts/apply-d1-migrations.mjs --local",
    "cf-typegen": "cf workers types",
    "d1:migrations:apply:production": "node scripts/apply-d1-migrations.mjs --remote",
    "generate": "node scripts/generate-route-tree.mjs && pnpm run cf-typegen && pnpm run generate:artifacts",
    "generate:artifacts": "node scripts/generate-artifacts.mjs",
    "skills:sync": "node scripts/sync-cloudflare-skills.mjs",
    "test": "vitest run",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "test:conversation-agent": "vitest run --config vitest.conversation-agent.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:watch": "vitest",
    "lint:code": "eslint --cache --cache-location ./node_modules/.cache/eslint app cloudchef-agent scripts make-bootstrap-snapshot.js",
    "lint": "pnpm run lint:code && pnpm run lint:format && pnpm run lint:oxlint",
    "lint:format": "prettier -c --cache --cache-strategy content .",
    "lint:oxlint": "oxlint --format=json | node scripts/check-oxlint-baseline.mjs",
    "lint:oxlint:update": "oxlint --format=json | node scripts/check-oxlint-baseline.mjs --update",
    "lint:fix-code": "pnpm run lint:code --fix",
    "lint:fix": "pnpm run lint:fix-code && prettier --write .",
    "typecheck": "pnpm run generate && pnpm run typecheck:check",
    "typecheck:check": "tsc --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.tsbuildinfo",
    "clean": "node scripts/clean.js",
    "ops": "node scripts/ops-report.mjs",
    "ops:json": "node scripts/ops-report.mjs --json",
    "ops:session": "node scripts/ops-session.mjs",
    "provision:production": "node scripts/provision-cloudflare-production.mjs",
    "provision:production:check": "node scripts/provision-cloudflare-production.mjs --check",
    "verify:stack": "node scripts/verify-stack-alignment.mjs",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "verify:workers-builds-config": "node scripts/workers-builds-config.mjs",
    "verify:licenses": "node scripts/verify-production-licenses.mjs",
    "verify:built-ssr": "node scripts/verify-built-ssr.mjs",
    "verify:built-browser": "pnpm run d1:migrations:apply:local && playwright test --project=chromium --project=mobile-chromium",
    "verify:static-assets": "node scripts/verify-static-assets.mjs",
    "validate": "node scripts/validate.mjs",
    "knip": "knip --treat-config-hints-as-errors && knip --config knip.production.jsonc --treat-config-hints-as-errors",
    "verify:copy-assertions": "node scripts/verify-copy-assertions.mjs"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.159",
    "@cloudchef/user-workspace-runtime": "workspace:*",
    "@cloudflare/ai-chat": "^0.12.2",
    "@cloudflare/computer": "0.2.1",
    "@cloudflare/sandbox": "0.13.0-next.724.1",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-wast": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@nanostores/react": "^2.0.1",
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@tanstack/db": "0.6.17",
    "@tanstack/query-db-collection": "1.2.1",
    "@tanstack/react-db": "0.1.95",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "agents": "^0.29.0",
    "ai": "7.0.155",
    "cloudchef-agent": "workspace:*",
    "date-fns": "^3.6.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.18.2",
    "ignore": "^7.0.14",
    "isomorphic-git": "1.44.7",
    "jszip": "^3.10.2",
    "memfs": "4.80.0",
    "nanostores": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "smol-toml": "1.9.1",
    "sonner": "^2.0.8",
    "unist-util-visit": "^5.2.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@blitz/eslint-plugin": "0.1.5",
    "@cloudflare/config": "0.28.1",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.3",
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261028.1",
    "@oxlint/plugins": "1.90.0",
    "@playwright/test": "1.64.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "cf": "1.0.0-beta.24",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "jsdom": "^26.1.0",
    "knip": "^5.88.1",
    "oxlint": "1.90.0",
    "postcss": "^8.5.32",
    "postcss-mixins": "^11.0.3",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.9.10",
    "tailwind-scrollbar": "3.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.3.5",
    "vite-plugin-optimize-css-modules": "^1.4.0",
    "vitest": "^4.1.12",
    "wrangler": "4.154.0"
  },
  "packageManager": "pnpm@11.14.0"
}
